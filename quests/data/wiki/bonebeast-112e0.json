>Ice <span typeof=\"mw:File\"><span><img alt=\"Freezing Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Freezing_Icon_Big_4dcec8.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:80.0000%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 20.0000%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.1000\" title=\"Fire\"><div class=\"creature-resistance-label\">Fire <span typeof=\"mw:File\"><span><img alt=\"Burning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Burning_Icon_Big_a56686.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:88.0000%; background-color:#27c429; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 12.0000%); display:inline-block;\">110%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Energy\"><div class=\"creature-resistance-label\">Energy <span typeof=\"mw:File\"><span><img alt=\"Electrified Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Electrified_Icon_Big_b60abe.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:80.0000%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 20.0000%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Earth\"><div class=\"creature-resistance-label\">Earth <span typeof=\"mw:File\"><span><img alt=\"Po