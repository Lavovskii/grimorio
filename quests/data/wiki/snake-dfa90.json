{"t":"Snake","s":"snake-dfa90","k":"creature","i":"assets/wiki/Snake_193217.gif","q":36,"html":"<div class=\"mw-content-ltr mw-parser-output\" dir=\"ltr\" lang=\"en\"><div class=\"twbox\">\n<aside class=\"portable-infobox pi-background pi-border-color pi-theme-twbox pi-layout-default\" role=\"region\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\">Snake</h2>\n<figure class=\"pi-item pi-image\">\n<img alt=\"Snake\" class=\"pi-image-thumbnail\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Snake_193217.gif\" width=\"32\"/>\n</figure>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Combat Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"hp\">\n<h3 class=\"pi-data-label pi-secondary-font\">Health</h3>\n<div class=\"pi-data-value pi-font\">15 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Health\"><img alt=\"Health\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Health_Icon_4142d2.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"exp\">\n<h3 class=\"pi-data-label pi-secondary-font\">Experience</h3>\n<div class=\"pi-data-value pi-font\">10 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Experience\"><img alt=\"Experience\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Experience_Icon_12adf8.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiarylevel\">\n<h3 class=\"pi-data-label pi-secondary-font\">Animus</h3>\n<div class=\"pi-data-value pi-font\">10~10 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Experience\"><img alt=\"Experience\" class=\"mw-f