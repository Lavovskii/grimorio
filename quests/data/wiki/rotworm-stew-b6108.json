pi-data pi-item-spacing pi-border-color\" data-source=\"marketable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Marketable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"value\">\n<h3 class=\"pi-data-label pi-secondary-font\">Value</h3>\n<div class=\"pi-data-value pi-font\">Negotiable</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"npcvalue\">\n<h3 class=\"pi-data-label pi-secondary-font\">Sold for</h3>\n<div class=\"pi-data-value pi-font\">(not bought by NPCs)</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"npcprice\">\n<h3 class=\"pi-data-label pi-secondary-font\">Bought for</h3>\n<div class=\"pi-data-value pi-font\">(not sold by NPCs)</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Field Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walkable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Blocking</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-cross\" title=\"No\">✗</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Utility Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Usable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"consumable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Consumable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"regenseconds\">\n<h3 class=\"pi-data-label pi-secondary-font\">Regeneration</h3>\n<div class=\"pi-data-value pi-font\">0 seconds<br/><small>(0% full)</small></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\">8.50<br/><span class=\"implementation-date\">July 1, 2009<br/>Summer Update 2009</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: Objects<span class=\"explained\">Help</span></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-object-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20090620230336&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Rotworm_Stew_1304dc.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"item-look tibiatext tibiagreen\">You see  rotworm stew.<div class=\"p-weight\">It weighs 12.00 oz.</div><div class=\"p-flavortext\">It's hot, beefy and delicious. The perfect food for knights.</div><br/></div></div>\n<div class=\"\" id=\"w-twbox-sounds\"><span class=\"tibiatext tibiaorange\"><ul class=\"sound-list\"><li>Gulp.</li></ul></span></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-object-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<p>It will heal you completely. To create this dish, you must speak with the <a href=\"#/wiki/Djinn\">Djinn</a> <a href=\"#/wiki/Jean%20Pierre\">Jean Pierre</a> in <a href=\"#/wiki/Ankrahmun\">Ankrahmun</a>, near the Marid Fortress, during the Hot Cuisine event.\n</p><p>When using Rotworm Stew, Green Sparkles Effect <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Green Sparkles Effect\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Green_Sparkles_Effect_f26b9f.gif\" width=\"32\"/></span></span> will appear on the user who will get the following message: \"<span class=\"tibiatext tibiawhite\">You were healed completely.</span>\". Note that you can only eat this dish once every 10 minutes. This cooldown is shared with all other <a href=\"#/wiki/Jean%20Pierre\">Jean Pierre</a> dishes as well as with all Hireling dishes, but not with Cupcakes. \n</p><p><b>Necessary Ingredients:</b>\n</p>\n<ul><li>2 <a href=\"#/wiki/Meat\">Meat</a> <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Meat\"><img alt=\"Meat\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Meat_7cb26b.gif\" width=\"32\"/></a></span></span></li>\n<li>20 <a href=\"#/wiki/Potato\">Potatoes</a> <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Potato\"><img alt=\"Potato\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Potato_aaaae8.gif\" width=\"32\"/></a></span></span></li>\n<li>1 <a href=\"#/wiki/Onion\">Onion</a> <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Onion\"><img alt=\"Onion\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Onion_24ccdb.gif\" width=\"32\"/></a></span></span></li>\n<li>1 <a href=\"#/wiki/Bulb%20of%20Garlic\">Bulb of Garlic</a> <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Bulb%20of%20Garlic\"><img alt=\"Bulb of Garlic\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Bulb_of_Garlic_3b8ee8.gif\" width=\"32\"/></a></span></span></li>\n<li>5 ounces of <a href=\"#/wiki/Flour\">Flour</a> <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Flour\"><img alt=\"Flour\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Flour_e828c3.gif\" width=\"32\"/></a></span></span></li>\n<li>2 <a href=\"#/wiki/Vial\">Vials</a> of <a href=\"#/wiki/Beer\">Beer</a> <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Beer\"><img alt=\"Beer\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Beer_8eddda.gif\" width=\"32\"/></a></span></span></li></ul>\n<p>Only obtainable through the <a href=\"#/quest/hot-cuisine-quest\">Hot Cuisine Quest</a>.\n</p>\n</div>\n<p><br/>\n</p>\n<div style=\"clear:left;\"></div>\n<div id=\"w-item-droppedby\">\n<h3><span class=\"mw-headline\" id=\"w-Dropped_By\">Dropped By</span></h3>\n<div class=\"item-droppedby-wrapper\">\n<ul class=\"creature-list-generic no-results\"><li>This item is not dropped by any creatures.</li></ul>\n<div style=\"clear:left;\"></div>\n</div>\n</div>\n<div style=\"clear:both;\"></div>\n<div id=\"w-item-trades\">\n<h3 class=\"semantic-header\"><span class=\"mw-headline\" id=\"w-Trade_Details\">Trade Details</span></h3>\n<div class=\"trades\"><h4><span class=\"mw-headline\" id=\"w-Buy_From\">Buy From</span></h4><p class=\"no-results\">No NPC sells this item.</p></div>\n<div class=\"trades\"><h4><span class=\"mw-headline\" id=\"w-Sell_To\">Sell To</span></h4><p class=\"no-results\">No NPC buys this item.</p></div>\n</div>\n<div style=\"clear:both;\"></div>\n<div style=\"clear:both;\"></div>\n<div class=\"navigation\">\n<h3><span class=\"mw-headline\" id=\"w-Related_Pages\">Related Pages</span></h3>\n<div class=\"navigation-body navigation-list-wrapper\">\n<ul><li><a href=\"#/wiki/Beer\">Beer</a></li><li><a href=\"#/wiki/Bulb%20of%20Garlic\">Bulb of Garlic</a></li><li><a href=\"#/wiki/Flour\">Flour</a></li><li><a href=\"#/wiki/Food\">Food</a></li><li><a href=\"#/quest/hot-cuisine-quest\">Hot Cuisine Quest</a></li><li><a href=\"#/wiki/Meat\">Meat</a></li><li><a href=\"#/wiki/Onion\">Onion</a></li><li><a href=\"#/wiki/Potato\">Potato</a></li><li>Regeneration</li><li><a href=\"#/wiki/Terofar\">Terofar</a></li><li><a href=\"#/wiki/Vial\">Vial</a></li></ul>\n</div>\n</div></div></div>","quests":["hot-cuisine-quest"],"howto":{"quests":[{"slug":"hot-cuisine-quest","quest":"Hot Cuisine Quest","step":"2-0","n":7,"title":"Prato 1: Rotworm Stew","kind":"reward","coords":[{"x":33068,"y":32531,"z":6,"label":"Jean Pierre"}]},{"slug":"hot-cuisine-quest","quest":"Hot Cuisine Quest","step":"4-0","n":24,"title":"Efeitos dos pratos","kind":"reward","coords":[]}]}}