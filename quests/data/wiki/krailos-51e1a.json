span class=\"yes-tick\" title=\"Yes\">✓</span></td><td style=\"\"><strong class=\"mw-selflink selflink\">Krailos</strong> depot.</td></tr>\n<tr><td style=\"width: 100px;\"><a href=\"#/wiki/Mugruu\">Mugruu</a></td><td class=\"npc-animation\" style=\"width: 128px; text-align: center; line-height: 64px;\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Mugruu\"><img alt=\"Mugruu\" class=\"mw-file-element\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Mugruu_3fd467.gif\" width=\"73\"/></a></span></td><td style=\"width: 110px; text-align: center;\"><a href=\"#/wiki/Shopkeeper%20NPCs\">Shopkeeper</a></td><td style=\"width: 72px; text-align: center;\"><span class=\"yes-tick\" title=\"Yes\">✓</span></td><td style=\"\"><strong class=\"mw-selflink selflink\">Krailos</strong>.</td></tr>\n<tr><td style=\"width: 100px;\"><a href=\"#/wiki/Nibble\">Nibble</a></td><td class=\"npc-animation\" style=\"width: 128px; text-align: center; line-height: 64px;\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Nibble\"><img alt=\"Nibble\" class=\"mw-file-element\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Nibble_3503b9.gif\" width=\"64\"/></a></span></td><td style=\"width: 110px; text-align: center;\">Tribe Leader</td><td style=\"width: 72px; text-align: center;\"><span class=\"no-cross\" title=\"No\">✗</span></td><td style=\"\"><strong class=\"mw-selflink selflink\">Krailos</strong>.</td></tr>\n<tr><td style=\"width: 100px;\"><a href=\"#/wiki/Vuzrog\">Vuzrog</a></td><td class=\"npc-animation\" style=\"width: 128px; text-align: center; line-height: 64px;\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Vuzrog\"><img alt=\"Vuzrog\" class=\"mw-file-element\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Vuzrog_3a3151.gif\" width=\"72\"/></a></span></td><td style=\"width: 110px; text-align: center;\">Tribe Leader</td><td style=\"width: 72px; text-align: center;\"><span class=\"no-cross\" title=\"No\">✗</span></td><td sty