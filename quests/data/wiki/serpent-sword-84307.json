-item-spacing pi-border-color\" data-source=\"npcvalue\">\n<h3 class=\"pi-data-label pi-secondary-font\">Sold for</h3>\n<div class=\"pi-data-value pi-font\">900 gp</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"npcprice\">\n<h3 class=\"pi-data-label pi-secondary-font\">Bought for</h3>\n<div class=\"pi-data-value pi-font\">6,000 gp</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Field Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walkable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Blocking</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-cross\" title=\"No\">✗</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Utility Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Usable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\">5.0<br/><span class=\"implementation-date\">June 18, 1999<br/>Beta 5.0</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: Objects<span class=\"explained\">Help</span></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-object-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20120411043049&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Serpent_Sword_bbb6f6.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"item-look tibiatext tibiagreen\">You see a serpent sword <span class=\"p-attributes\">(Atk:18 physical +8 earth, Def:15 +1)</span>.<br/>Classification: 1 Tier: 0.<div class=\"p-weight\">It weighs 41.00 oz.</div><br/></div></div>\n<div class=\"\" id=\"w-twbox-sounds\"><span class=\"tibiatext tibiaorange\"><ul class=\"sound-list\"></ul></span></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-object-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<p>Good sword for low <a href=\"#/wiki/Level\">levels</a>.<br/>\nIt has an attack of 18 <a href=\"#/wiki/Physical%20Damage\">Physical Damage</a> plus 8 Earth Damage, thus it is a good weapon to hunt monsters weak to Earth Damage, like <a href=\"#/wiki/Cyclops\">Cyclops</a>.<br/>\nCan be obtained as a reward in the <a href=\"#/quest/draconia-quest\">Draconia Quest</a>.\n</p>\n</div>\n<div id=\"w-object-proficiency\">\n<h3><span class=\"mw-headline\" id=\"w-Weapon_Proficiency\">Weapon Proficiency</span></h3>\n<div class=\"weapon_proficiency weapon_proficiency_border\">\n<table class=\"weapon_proficiency_number_table\">\n<tbody><tr>\n<td>1</td>\n<td>2</td>\n<td>3</td>\n<td>4\n</td></tr>\n</tbody></table>\n<table class=\"weapon_proficiency_table\">\n<tbody><tr>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Weapon Shield Mod\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+1 defence modifier</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Sword Extra Damage Auto-Attack\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20250629110320&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Gain_Extra_Damage_Auto_Attack_099693.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+4% of your Sword Fighting as extra damage for auto-attacks</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Hit Chance\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+2% critical hit chance for auto-attacks</div></div>\n<div><div class=\"weapon_proficiency_icon\" title=\"Mana Gain on Kill\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+5 mana on kill</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_borde