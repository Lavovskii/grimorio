ontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"exp\"><p style=\"text-align: center; color: green\"><b>Good</b></p><p style=\"text-align: center; margin: 0.4em 0 0.5em;\"><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><br/><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span></p></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"loot\"><p style=\"text-align: center; color: green\"><b>Good</b></p><p style=\"text-align: center; margin: 0.4em 0 0.5em;\"><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><br/><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span></p></td>\n</tr>\n</tbody>\n</table>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<table class=\"pi-horizontal-group pi-horizontal-group-no-labels\">\n<caption class=\"pi-header pi-secondary-font pi-secondary-background pi-item-spacing\">Notable Loot</caption>\n<tbody>\n<tr>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Dragon%20Scale%20Mail\"><img alt=\"Dragon Scale Mail\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Dragon_Scale_Mail_723a12.gif\" width=\"32\"/></a></span></span></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot2\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Royal%20Helmet\"><img alt=\"Royal Helmet\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Royal_Helmet_44a9ae.gif\" width=\"32\"/></a></span></span></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot3\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Dragon%20Slayer\"><img alt=\"Dragon Slayer\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Dragon_Slayer_9866f8.gif\" width=\"32\"/></a></span></span></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot4\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Dragon%20Lord%20Trophy\"><img alt=\"Dragon Lord Trophy\" class=\"mw-file-element\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Dragon_Lord_Trophy_23028d.gif\" width=\"64\"/></a></span></span></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot5\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Tower%20Shield\"><img alt=\"Tower Shield\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Tower_Shield_ea3208.gif\" width=\"32\"/></a></span></span></td>\n</tr>\n</tbody>\n</table>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"implementation-date\">6.4<br/>November 2, 2001</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\"><p>\t    See also: Hunting Places <span class=\"explained\">Help</span></p></nav>\n</aside>\n<p>The <b>Edron Dragon Lair</b> is situated north of <a href=\"#/wiki/Edron\">Edron</a>, west of the gates to <a href=\"#/wiki/Hero%20Cave\">Hero Cave</a> and <a href=\"#/wiki/Cyclopolis\">Cyclopolis</a>. Here you will have the opportunity to fight <a href=\"#/wiki/Dragon%20Hatchling\">Dragon Hatchlings</a>, <a href=\"#/wiki/Dragon%20Lord%20Hatchling\">Dragon Lord Hatchlings</a> , <a href=\"#/wiki/Dragon\">Dragons</a> and <a href=\"#/wiki/Dragon%20Lord\">Dragon Lords</a>. You can also find a few <a href=\"#/wiki/Wyvern\">Wyverns</a> nearby.\n</p><p>In Edron Dragon Lair you can find the <a href=\"#/quest/fire-axe-quest\">Fire Axe Quest</a>.\n</p>\n<h2><span class=\"mw-headline\" id=\"w-Hunting_Strategies\">Hunting Strategies</span></h2>\n<ul><li><i><a href=\"#/wiki/Knight\">Knights</a></i>:It is not advisable to go solo if you are a low level knight, because spawns usually come up two or three at a time. This will be a waste of potions as killing the dragons will be very slow and probably inefficient. If the knight wants to go for blocking then a small team of one or two shooters would be suitable for that purpose.\n<ul><li>It is a semi large spawn, so it should be very good for high level knights that choose to hunt solo.</li></ul></li></ul>\n<ul><li><i><a href=\"#/wiki/Druid\">Druids</a> and <a href=\"#/wiki/Sorcerer\">Sorcerers</a></i>: For low level mages it is strongly advisable to stay on the surface where there are only 2 dragons. One or two summoned <a href=\"#/wiki/Demon%20Skeleton\">Demon Skeletons</a> should do the blocker work. It is recommended that they bring many <a href=\"#/wiki/Icicle%20Rune\">Icicle runes</a>. Also a quite a few <a href=\"#/wiki/Mana%20Potion\">Mana Potions</a> for healing spells and of course a death wand or ice rod and ice strike.\n<ul><li>Higher level mages might choose to go underground as well and use <a href=\"#/wiki/Icicle%20Rune\">Icicle runes</a> and attack spells (ice strike) to kill the dragons quicker. It is advisable to bring quite a few <a href=\"#/wiki/Mana%20Potion\">Mana Potion</a>.</li></ul></li></ul>\n<ul><li><i><a href=\"#/wiki/Paladin\">Paladins</a></i>: Low level paladins should consider Stairhopping the first two dragons underground. Use either Royal Spears or <a href=\"#/wiki/Throwing%20Star\">Throwing Stars</a>. Bring <a href=\"#/wiki/Mana%20Potion\">Mana Potions</a> just in case.\n<ul><li>High level paladins can go deeper into the lair, but be careful of the <a href=\"#/wiki/Dragon%20Lord\">Dragon Lords</a>. It is a fairly good running place.</li></ul></li></ul>\n<p>Dragons are <a href=\"#/wiki/Skinning\">skinnable</a> so a useful tool to have would be an <a href=\"#/wiki/Obsidian%20Knife\">Obsidian Knife</a> to obtain <a href=\"#/wiki/Red%20Dragon%20Leather\">red</a> and <a href=\"#/wiki/Green%20Dragon%20Leather\">green</a> dragon leather. Also for low level mages and paladins it is advisable to use magic shield \"Utamo Vita\" in case the dragon retargets. Knights should also remember to use \"exeta res\" to avoid retargeting on members of their team.\n</p><p>The Legendary <a href=\"#/wiki/Orshabaal\">Orshabaal</a> spawns near the entrance!!!\n</p>\n<div style=\"clear:both;\"></div>\n<div style=\"clear:both;\"></div><table cellspacing=\"0\" class=\"wikitable sortable full-width\"><tbody><tr><th>Name</th><th data-sort-type=\"number\" style=\"width: 38px; text-align: center;\">Exp</th><th data-sort-type=\"number\" style=\"text-align: center;\">HP</th><th data-sort-type=\"number\" style=\"text-align: center;\">Max. Damage</th><th style=\"font-size: small;\">Loot</th></tr>\n<tr><td style=\"width: 100px; text-align: center\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Dragon%20Hatchling\"><img alt=\"Dragon Hatchling\" class=\"mw-file-element\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Dragon_Hatchling_61f167.gif\" width=\"64\"/></a></span></span><br/><a href=\"#/wiki/Dragon%20Hatchling\">Dragon Hatchling</a></td><td style=\"width: 38px; text-align: center;\">185</td><td style=\"text-align: center;\">380</td><td style=\"text-align: center;\">200 (<span style=\"white-space: nowrap\">55 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Physical%20Damage\"><img alt=\"Physical Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Physical_Damage_Icon_356411.gif\" width=\"9\"/></a></span></span></span>, <span style=\"white-space: nowrap\">145 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Fire%20Damage\"><img alt=\"Fire Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Fire_Damage_Icon_7ba5fe.gif\" width=\"9\"/></a></span></span></span>)</td><td style=\"font-size: small;\"><div class=\"loot-table\" id=\"w-loot_perc_loot\">\n<ul><li>0-55× <a href=\"#/wiki/Gold%20Coin\">Gold Coin</a> (common)</li>\n<li><a href=\"#/wiki/Dragon%20Ham\">Dragon Ham</a> (common)</li>\n<li>Dragon's Tail (semi-rare)</li>\n<li><a href=\"#/wiki/Health%20Potion\">Health Potion</a> (very rare)</li>\n</ul>\n</div></td></tr><tr><td style=\"width: 100px; text-align: center\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Dragon%20Lord%20Hatchling\"><img alt=\"Dragon Lord Hatchling\" class=\"mw-file-element\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Dragon_Lord_Hatchling_50af48.gif\" width=\"64\"/></a></span></span><br/><a href=\"#/wiki/Dragon%20Lord%20Hatchling\">Dragon Lord Hatchling</a></td><td style=\"width: 38px; text-align: center;\">645</td><td style=\"text-align: center;\">750</td><td style=\"text-align: center;\">335</td><td style=\"font-size: small;\"><div class=\"loot-table\" id=\"w-loot_perc_loot\">\n<ul><li>1-165× <a href=\"#/wiki/Gold%20Coin\">Gold Coin</a> (common)</li>\n<li><a href=\"#/wiki/Dragon%20Ham\">Dragon Ham</a> (common)</li>\n<li><a href=\"#/wiki/Green%20Mushroom\">Green Mushroom</a> (rare)</li>\n<li><a href=\"#/wiki/Mana%20Potion\">Mana Potion</a> (rare)</li>\n<li>Magma Boots (very rare)</li>\n</ul>\n</div></td></tr><tr><td style=\"width: 100px; text-align: center\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Wyvern\"><img alt=\"Wyvern\" class=\"mw-file-element\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Wyvern_a6f445.gif\" width=\"64\"/></a></span></span><br/><a href=\"#/wiki/Wyvern\">Wyvern</a></td><td style=\"width: 38px; text-align: center;\">515</td><td style=\"text-align: center;\">795</td><td style=\"text-align: center;\">144</td><td style=\"font-size: small;\"><div class=\"loot-table\" id=\"w-loot_perc_loot\">\n<ul><li>1-90× <a href=\"#/wiki/Gold%20Coin\">Gold Coin</a> (common)</li>\n<li>0-3× <a href=\"#/wiki/Dragon%20Ham\">Dragon Ham</a> (common)</li>\n<li>Wyvern Talisman (uncommon)</li>\n<li><a href=\"#/wiki/Small%20Sapphire\">Small Sapphire</a> (semi-rare)</li>\n<li><a href=\"#/wiki/Power%20Bolt\">Power Bolt</a> (semi-rare)</li>\n<li><a href=\"#/wiki/Strong%20Health%20Potion\">Strong Health Potion</a> (semi-rare)</li>\n<li><a href=\"#/wiki/Emerald%20Bangle\">Emerald Bangle</a> (rare)</li>\n<li><a href=\"#/wiki/Wand%20of%20Inferno\">Wand of Inferno</a> (rare)</li>\n<li>Wyvern Fang (rare)</li>\n</ul>\n</div></td></tr><tr><td style=\"width: 100px; text-align: center\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Dragon\"><img alt=\"Dragon\" class=\"mw-file-element\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Dragon_24987b.gif\" width=\"64\"/></a></span></span><br/><a href=\"#/wiki/Dragon\">Dragon</a></td><td style=\"width: 38px; text-align: center;\">700</td><td style=\"text-align: center;\">1,000</td><td style=\"text-align: center;\">430 (<span style=\"white-space: nowrap\">120 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Physical%20Damage\"><img alt=\"Physical Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Physical_Damage_Icon_356411.gif\" width=\"9\"/></a></span></span></span>, <span style=\"white-space: nowrap\">310 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Fire%20Damage\"><img alt=\"Fire Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Fire_Damage_Icon_7ba5fe.gif\" width=\"9\"/></a></span></span></span>)</td><td style=\"font-size: small;\"><div class=\"loot-table\" id=\"w-loot_perc_loot\">\n<ul><li>1-105× <a href=\"#/wiki/Gold%20Coin\">Gold Coin</a> (common)</li>\n<li>1-3× <a href=\"#/wiki/Dragon%20Ham\">Dragon Ham</a> (common)</li>\n<li><a href=\"#/wiki/Steel%20Shield\">Steel Shield</a> (uncommon)</li>\n<li><a href=\"#/wiki/Crossbow\">Crossbow</a> (uncommon)</li>\n<li>Dragon's Tail (uncommon)</li>\n<li>1-10× <a href=\"#/wiki/Burst%20Arrow\">Burst Arrow</a> (uncommon)</li>\n<li><a href=\"#/wiki/Longsword\">Longsword</a> (semi-rare)</li>\n<li><a href=\"#/wiki/Steel%20Helmet\">Steel Helmet</a> (semi-rare)</li>\n<li><a href=\"#/wiki/Broadsword\">Broadsword</a> (semi-rare)</li>\n<li><a href=\"#/wiki/Plate