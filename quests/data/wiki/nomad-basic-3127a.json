{"t":"Nomad (Basic)","s":"nomad-basic-3127a","k":"creature","i":"assets/wiki/Nomad_Basic_61ec56.gif","q":14,"html":"<div class=\"mw-content-ltr mw-parser-output\" dir=\"ltr\" lang=\"en\"><div class=\"twbox\">\n<aside class=\"portable-infobox pi-background pi-border-color pi-theme-twbox pi-layout-default\" role=\"region\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\">Nomad (Basic)</h2>\n<figure class=\"pi-item pi-image\">\n<img alt=\"Nomad (Basic)\" class=\"pi-image-thumbnail\" height=\"64\" loading=\"lazy\" src=\"assets/wiki/Nomad_Basic_61ec56.gif\" width=\"64\"/>\n</figure>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Combat Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"hp\">\n<h3 class=\"pi-data-label pi-secondary-font\">Health</h3>\n<div class=\"pi-data-value pi-font\">160 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Health\"><img alt=\"Health\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Health_Icon_4142d2.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"exp\">\n<h3 class=\"pi-data-label pi-secondary-font\">Experience</h3>\n<div class=\"pi-data-value pi-font\">60 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Experience\"><img alt=\"Experience\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Experience_Icon_12adf8.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiarylevel\">\n<h3 class=\"pi-data-label pi-secondary-font\">Animus</h3>\n<div class=\"pi-data-value pi-font\">61~62 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Experi