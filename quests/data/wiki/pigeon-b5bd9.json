r:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 9.0909%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Energy\"><div class=\"creature-resistance-label\">Energy <span typeof=\"mw:File\"><span><img alt=\"Electrified Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Electrified_Icon_Big_b60abe.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:90.9091%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 9.0909%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.1000\" title=\"Earth\"><div class=\"creature-resistance-label\">Earth <span typeof=\"mw:File\"><span><img alt=\"Poisoned Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Poisoned_Icon_Big_f04eb1.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:100.0000%; background-color:#27c429; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 0.0000%); display:inline-block;\">110%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Drown\"><div class=\"creature-resistance-label\">Drown <span typeof=\"mw:File\"><span><img alt=\"Drowning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Drowning_Icon_Big_f65e47.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:90.9091%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 9.0909%); display:inline-block;\">100%?</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Healing\"><div class=\"creature-resistance-label\">Healing <span typeof=\"mw:File\"><span><img alt=\"Healing Icon\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Healing_Icon_be4df6.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:90.9091%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 9.0909%); display:inline-block;\">100%</div></div></div>\n</div><div style=\"clear:left;\"></div>\n</div>\n<div id=\"w-creature-location\">\n<h3><span class=\"mw-headline\" id=\"w-Location\">Location</span></h3>\n<p><a href=\"#/wiki/Streets%20of%20Venore\">Streets of Venore</a>, <a href=\"#/wiki/Gardens%20of%20Night\">Gardens of Night</a>.\n</p>\n</div>\n<div id=\"w-creature-behaviour\">\n<h3><span class=\"mw-headline\" id=\"w-Behaviour\">Behaviour</span></h3>\n<p>\tThey fly away from you.<br/><br/>A pigeon does not attack. A pigeon will retreat at 30  (100%, full) health.\n</p>\n</div>\n<div id=\"w-creature-strategy\">\n<h3><span class=\"mw-headline\" id=\"w-Strategy\">Strategy</span></h3>\n<p>\tYou can just kill them, they won't attack you. Or you could leave them be.\n</p>\n</div>\n<div style=\"clear:both;\"></div>\n<div>\n<h3><span class=\"mw-headline\" id=\"w-Loot\">Loot</span></h3>\n<p><small><i>Drop rates are estimated based on 3,194 samples <span class=\"loot-stats-link\">(Loot Statistics)</span>.</i></small> <small><i>Colour-coding is applied after 500 samples.</i></small><br/><small><i>Task column indicates items used in delivery tasks.</i></small>\n</p>\n<table class=\"wikitable sortable\" style=\"text-align:center; width:auto;\">\n<tbody><tr>\n<th></th>\n<