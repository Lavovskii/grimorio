class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Experience_Icon_12adf8.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"speed\">\n<h3 class=\"pi-data-label pi-secondary-font\">Speed</h3>\n<div class=\"pi-data-value pi-font\">58 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Speed\"><img alt=\"Speed\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Haste_Icon_105a69.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"armor\">\n<h3 class=\"pi-data-label pi-secondary-font\">Armor</h3>\n<div class=\"pi-data-value pi-font\">8 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Armor\"><img alt=\"Armor\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Armor_Icon_c70b3b.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"mitigation\">\n<h3 class=\"pi-data-label pi-secondary-font\">Mitigation</h3>\n<div class=\"pi-data-value pi-font\">0.44% <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Mitigation\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Mitigation_Icon_7ae0f5.png\" width=\"9\"/></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usedelements\">\n<h3 class=\"pi-data-label pi-secondary-font\">Elements</h3>\n<div class=\"pi-data-value pi-font\">Physical</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"maxdmg\">\n<h3 class=\"pi-data-label pi-secondary-font\">Est. Max Dmg</h3>\n<div class=\"pi-data-value pi-font\"><span style=\"white-space: nowrap\">40 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"