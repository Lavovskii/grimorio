v class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiaryclass\">\n<h3 class=\"pi-data-label pi-secondary-font\">Class</h3>\n<div class=\"pi-data-value pi-font\">Humanoid</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiarylevel\">\n<h3 class=\"pi-data-label pi-secondary-font\">Difficulty</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Easy\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Level_Easy_76d062.gif\" width=\"57\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Occurrence</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Common\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Occurrence_Common_bbcd9e.gif\" width=\"46\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Charm Points</h3>\n<div class=\"pi-data-value pi-font\">15 <span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Charm Icon\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Charm_Icon_d968ed.gif\" width=\"11\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Kills to Unlock</h3>\n<div class=\"pi-data-value pi-font\">500</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"attacktype\">\n<h3 class=\"pi-data-label pi-secondary-font\">Behaviour</h3>\n<div class=\"pi-data-value pi-font\"><span title=\"Creature attacks from a distance\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Distance Fighting Icon\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Distance_Fighting_Icon_30f2a7.png\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiarylevel\">\n<h3 class=\"pi-data-label pi-secondary-font\">Soul Core</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Dworc Venomsniper Soul Core\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Dworc_Venomsniper_Soul_Core_4cdcdf.gif\" width=\"32\"/></span></span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Immunity Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"paraimmune\">\n<h3 class=\"pi-data-label pi-secondary-font\">Paralysable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"senseinvis\">\n<h3 class=\"pi-data-label pi-secondary-font\">Sense Invis</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-cross\" title=\"No\">✗</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Behavioural Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walksaround\">\n<h3 class=\"pi-data-label pi-secondary-font\">Walks Around</h3>\n<div class=\"pi-data-value pi-font\"><span typeof=\"mw:File\"><span><img alt=\"Energy Field (Square)\" class=\"mw-file-element\" height=\"19\" loading=\"lazy\" src=\"assets/wiki/Energy_Field_Square_8987b7.gif\" width=\"18\"/></span></span> Energy<br/><span typeof=\"mw:File\"><span><img alt=\"Fire\" class=\"mw-file-element\" height=\"18\" loading=\"lazy\" src=\"assets/wiki/Fire_0ff2ec.gif\" width=\"18\"/></span></span> Fire</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walksthrough\">\n<h3 class=\"pi-data-label pi-secondary-font\">Walks Through</h3>\n<div class=\"pi-data-value pi-font\"><span typeof=\"mw:File\"><span><img alt=\"Poison Gas\" class=\"mw-file-element\" height=\"18\" loading=\"lazy\" src=\"assets/wiki/Poison_Gas_c58dd6.gif\" width=\"18\"/></span></span> Poison</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\">7.5<br/><span class=\"implementation-date\">August 09, 2005<br/>Summer Update 2005</span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"status\">\n<h3 class=\"pi-data-label pi-secondary-font\">Status</h3>\n<div class=\"pi-data-value pi-font\">Active</div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: <a href=\"#/wiki/Creatures\">Creatures</a></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-item-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20150418075549&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Dworc_Venomsniper_4f571d.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"creature-look tibiatext tibiagreen\">You see a dworc venomsniper.</div></div>\n<div class=\"\" id=\"w-twbox-sounds\"><span class=\"tibiatext tibiaorange\"><ul class=\"sound-list\"><li>Grow truk grrrrr.</li><li>Brak brrretz!</li><li>Prek tars, dekklep zurk.</li></ul></span></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-creature-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<div class=\"webdesc\"><blockquote class=\"webdesc-text\"><p>The Dworc Venomsnipers are usually the women of the tribes. It is disputable if this results in their weaker physical constitution or in the fact that they are simply smarter than the average dworcish male. They are the dworcs with the best knowledge and skills in brewing poison, and no Dworc Venomsniper has ever been encountered without carrying various vials filled with some toxin. Single snipers are a rare view. Usually, they hide behind the fleshhunters and hurl volleys of poisonous projectiles at their enemies from a safe distance. If they get cornered, they are easy prey since they lack the skill and weaponry to stand a serious assault on their own.</p></blockquote>\n<div class=\"webdesc-from\" style=\"float: right; margin: 0 2em 0 0;\">—Tibia Library</div>\n<div style=\"clear:both;\"></div>\n</div>\n<p>Venomsnipers are weak and fragile, even for a dworc. However, the poison it applies can be annoying in certain situations.\n</p>\n<div style=\"clear:left;\"></div>\n</div>\n<div id=\"w-creature-abilities\">\n<h3><span class=\"mw-headline\" id=\"w-Abilities\">Abilities</span></h3>\n<div class=\"ability_list\"><div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Physical%20Damage\"><img alt=\"Physical Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Physical_Damage_Icon_356411.gif\" width=\"9\"/></a></span></span> Melee</span> (0-15)</div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Poisoned\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Poisoned_Icon_7605e0.gif\" width=\"9\"/></span></span> Shoots Poison</span> (2 hp/turn)</div></div>\n<div style=\"clear:left;\"></div>\n</div>\n<div class=\"mobile-hide\" id=\"w-creature-resistance-table\">\n<h3><span class=\"mw-headline\" id=\"w-Damage_Taken_From_Elements\">Damage Taken From Elements</span></h3>\n<div id=\"w-creature-resistance-d\">\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Physical\"><div class=\"creature-resistance-label\">Physical <span typeof=\"mw:File\"><span><img alt=\"Bestiary Physical Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Physical_Icon_Big_83da43.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:88.4956%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 11.5044%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0800\" title=\"Death\"><div class=\"creature-resistance-label\">Death <span typeof=\"mw:File\"><span><img alt=\"Cursed Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Cursed_Icon_Big_de8a1f.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:95.5752%; background-color:#27c429; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 4.4248%); display:inline-block;\">108%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.8500\" title=\"Holy\"><div class=\"creature-resistance-label\">Holy <span typeof=\"mw:File\"><span><img alt=\"Dazzled Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Dazzled_Icon_Big_546495.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:75.2212%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 24.7788%); display:inline-block;\">85%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.1300\" title=\"Ice\"><div class=\"creature-resistance-label\">Ice <span typeof=\"mw:File\"><span><img alt=\"Freezing Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Freezing_Icon_Big_4dcec8.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:100.0000%; background-color:#27c429; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 0.0000%); display:inline-block;\">113%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.1300\" title=\"Fire\"><div class=\"creature-resistance-label\">Fire <span typeof=\"mw:File\"><span><img alt=\"Burning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Burning_Icon_Big_a56686.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:100.0000%; background-color:#27c429; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 0.0000%); display:inline-block;\">113%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Energy\"><div class=\"creature-resistance-label\">Energy <span typeof=\"mw:File\"><span><img alt=\"Electrified Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Electrified_Icon_Big_b60abe.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:88.4956%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 11.5044%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Earth\"><div class=\"creature-resistance-label\">Earth <span typeof=\"mw:File\"><span><img alt=\"Poisoned Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Poisoned_Icon_Big_f04eb1.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 0 1px 1px; width:0.0000%; background-color:#ff3333; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; left:calc(5px + 100% * 0.0000); display:inline-block;\">0%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Drown\"><div class=\"creature-resistance-label\">Drown <span typeof=\"mw:File\"><span><img alt=\"Drowning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Drowning_Icon_Big_f65e47.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:88.4956%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 11.5044%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Healing\"><div class=\"creature-resistance-label\">Healing <span typeof=\"mw:File\"><span><img alt=\"Healing Icon\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Healing_Icon_be4df6.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:88.4956%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 11.5044%); display:inline-block;\">100%</div></div></div>\n</div><div style=\"clear:left;\"></div>\n</div>\n<div id=\"w-creature-location\">\n<h3><span class=\"mw-headline\" id=\"w-Location\">Location</span></h3>\n<p>South of <a href=\"#/wiki/Port%20Hope\">Port Hope</a> (<a href=\"#/wiki/Tiquanda%2FTrapwood\">Trapwood</a>) on ground level and underground and on <a href=\"#/wiki/Foreigner%20Quarter\">Foreigner Quarter</a> of <a href=\"#/wiki/Yalahar\">Yalahar</a>.\n</p>\n</div>\n<div id=\"w-creature-behaviour\">\n<h3><span class=\"mw-headline\" id=\"w-Behaviour\">Behaviour</span></h3>\n<p>\tThey attack from a distance and shoot poison, they run in low health.<br/><br/>A dworc venomsniper attacks from a distance.\n</p>\n</div>\n<div id=\"w-creature-strategy\">\n<h3><span class=\"mw-headline\" id=\"w-Strategy\">Strategy</span></h3>\n<p>\tWhen fighting <a href=\"#/wiki/Dworcs\">Dworcs</a>, one strategy is to kill the <a href=\"#/wiki/Dworc%20Voodoomaster\">Dworc Voodoomasters</a> first, then the <a href=\"#/wiki/Dworc%20Fleshhunter\">Dworc Fleshhunters</a> and finally the venomsnipers.\n</p>\n</div>\n<div style=\"clear:left;\"></div>\n<div class=\"history-section\" id=\"w-creature-history\">\n<h3><span class=\"mw-headline\" id=\"w-History\">History</span></h3>\n<p>As of November 16, 2011, Dworc Venomsnipers as well as other poison-causing creatures can no longer be convinced. This was to prevent PvP abuse whereby a player would trick another player into convincing creatures that would later frag low level characters with poison applied earlier. After enough kills the player would obtain a Red Skull and would lose all items belonging to them upon being killed. More can be read in the news article \"Content Fixes\".\n</p>\n</div>\n<div style=\"clear:both;\"></div>\n<div>\n<h3><span class=\"mw-headline\" id=\"w-Loot\">Loot</span></h3>\n<p><small><i>Drop rates are estimated based on 105,108 samples <span class=\"loot-stats-link\">(Loot Statistics)</span>.</i></small> <small><i>Colour-coding is applied after 500 samples.</i></small><br/><small><i>Task column indicates items used in delivery tasks.</i></small>\n</p>\n<table class=\"wikitable sortable\" style=\"text-align:center; width:auto;\">\n<tbody><tr>\n<th></th>\n<th>Item</th>\n<th>Task</th>\n<th>Quantity</th>\n<th>Avg</th>\n<th data-sort-type=\"number\">%\n</th></tr>\n<tr>\n<td><span class=\"loot-table-icon\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Gold%20Coin\"><img alt=\"Gold Coin\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Gold_Coin_a5b511.gif\" width=\"32\"/></a></span></span></span></td>\n<td><a href=\"#/wiki/Gold%20Coin\">Gold Coin</a></td>\n<td></td>\n<td>1-13</td>\n<td>5.3</td>\n<td class=\"loot-common\" data-sort-value=\"74.975264\" style=\"text-align:center;\">75%\n</td></tr>\n<tr>\n<td></td>\n<td><i>Empty</i></td>\n<td></td>\n<td>1</td>\n<td>0.18</td>\n<td class=\"loot-uncommon\" data-sort-value=\"18.007193\" style=\"text-align:center;\">18.0%\n</td></tr>\n<tr>\n<td><span class=\"loot-table-icon\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Leather%20Armor\"><img alt=\"Leather Armor\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Leather_Armor_df7f92.gif\" width=\"32\"/></a></span></span></span></td>\n<td><a href=\"#/wiki/Leather%20Armor\">Leather Armor</a></td>\n<td></td>\n<td>1</td>\n<td>0.10</td>\n<td class=\"loot-uncommon\" data-sort-value=\"10.076302\" style=\"text-align:center;\">10.1%\n</td></tr>\n<tr>\n<td><span class=\"loot-table-icon\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Throwing%20Knife\"><img alt=\"Throwing Knife\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Throwing_Knife_cff9aa.gif\" width=\"32\"/></a></span></span></span></td>\n<td><a href=\"#/wiki/