><img alt=\"\" class=\"thumbimage\" height=\"152\" loading=\"lazy\" src=\"assets/wiki/Fire_Axe_Quest_Pile_of_Bones_6d9e09.png\" style=\"\" title=\"Fire Axe Quest Pile of Bones.png (135 KB)\" width=\"185\"/></div></div></div></div>\n</div>\n</div>\n</div>\n<div style=\"clear:both;\"></div>\n</div></div>","quests":[]}