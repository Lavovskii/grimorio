i-item-spacing pi-border-color\" data-source=\"npcvalue\">\n<h3 class=\"pi-data-label pi-secondary-font\">Sold for</h3>\n<div class=\"pi-data-value pi-font\">100 gp</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"npcprice\">\n<h3 class=\"pi-data-label pi-secondary-font\">Bought for</h3>\n<div class=\"pi-data-value pi-font\">500 gp</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Field Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"lightcolor\">\n<h3 class=\"pi-data-label pi-secondary-font\">Light</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"colorbox\" style=\"background-color: #0099ff; width: 1em; height: 1em; display: inline-block;\"></span><span style=\"margin: 0 0 0 0.4em;\">2 sqm</span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walkable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Blocking</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-cross\" title=\"No\">✗</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\">7.6<br/><span class=\"implementation-date\">December 12, 2005<br/>Christmas Update 2005</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: Objects<span class=\"explained\">Help</span></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-object-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20151003103135&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Wand_of_Vortex_cde461.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"item-look tibiatext tibiagreen\">You see a wand of vortex.<br/>Classification: 1 Tier: 0.<div class=\"p-reqs\">It can only be wielded properly by sorcerers of level 6 or higher.<br/></div><div class=\"p-weight\">It weighs 19.00 oz.</div><div class=\"p-flavortext\">Surges of energy rush through the tip of this wand.</div><br/></div></div>\n<div class=\"\" id=\"w-twbox-sounds\"></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-object-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<p>The <a href=\"#/wiki/Sorcerer\">sorcerer</a>'s equivalent of the <a href=\"#/wiki/Druid\">druid</a>'s <a href=\"#/wiki/Snakebite%20Rod\">Snakebite Rod</a> and the lowest-levelled wand available on the mainland. Provides 2 sqm of blue light. A rather effective weapon, as low level monsters are usually not resistant to energy damage. Wands of Vortex replaced <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Blue Spell Wand\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Blue_Spell_Wand_9a8fd9.gif\" width=\"32\"/></span></span> Blue Spell Wands in the Winter Update 2005. Looks the same as <a href=\"#/wiki/Xodet%27s%20First%20Wand\">Xodet's First Wand</a> and the <a href=\"#/wiki/Sorcerer%20and%20Druid%20Staff\">Sorc and Druid Staff</a>.\nNeeded for <a href=\"#/quest/mage-outfits-quest\">Mage Outfits Quest</a> (male) and <a href=\"#/quest/summoner-outfits-quest\">Summoner Outfits Quest</a> (female).\n</p>\n</div>\n<div id=\"w-object-proficiency\">\n<h3><span class=\"mw-headline\" id=\"w-Weapon_Proficiency\">Weapon Proficiency</span></h3>\n<div class=\"weapon_proficiency weapon_proficiency_border\">\n<table class=\"weapon_proficiency_number_table\">\n<tbody><tr>\n<td>1</td>\n<td>2</td>\n<td>3\n</td></tr>\n</tbody></table>\n<table class=\"weapon_proficiency_table\">\n<tbody><tr>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Hit Chance\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+2% critical hit chance for auto-attacks</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Magic Extra Damage Auto-Attack\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20250629110320&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Gain_Extra_Damage_Auto_Attack_099693.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+10% of your Magic Level as extra damage for auto-attacks</div></div>\n<div><div class=\"weapon_proficiency_icon\" title=\"Mana Gain on Kill\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+5 mana on kill</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Spell Damage Perk\">\n<div><img alt=\"16?cb=20250625080425&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Skillwheel_Small_Perk_Icons_a3449f.png\"/></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img38\"><img alt=\"38?cb=20140920174339&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Buzz_ef3d40.gif\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+20% base damage for Buzz</div></div></div>\n</td></tr>\n</tbody></table>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div class=\"history-section\" id=\"w-object-history\">\n<h3><span class=\"mw-headline\" id=\"w-History\">History</span></h3>\n<p>The Autumn Patch 2014 lowered the level requirement to wield this wand from 7 to 6.\n</p>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-item-droppedby\">\n<h3><span class=\"mw-headline\" id=\"w-Dropped_By\">Dropped By</span></h3>\n<div class=\"item-droppedby-wrapper\">\n<ul><li><a href=\"#/wiki/Muglex%20Clan%20Chief\">Muglex Clan Chief</a></li>\n<li><a href=\"#/wiki/Novice%20of%20the%20Cult\">Novice of the Cult</a></li>\n<li><a href=\"#/wiki/The%20Corruptor\">The Corruptor</a></li></ul>\n<div style=\"clear:left;\"></div>\n</div>\n</div>\n<div style=\"clear:both;\"></div>\n<div id=\"w-item-trades\">\n<h3 class=\"semantic-header\"><span class=\"mw-headline\" id=\"w-Trade_Details\">Trade Details</span></h3>\n<div class=\"trades\" id=\"w-npc-trade-buyfrom\"><h4><span class=\"mw-headline\" id=\"w-Buy_From\">Buy From</span></h4><table class=\"wikitable sortable\"><tbody><tr><th>NPC</th><th>Location</th><th data-sort-type=\"number\">Price</th></tr><tr style=\"text-align:center\"><td><a href=\"#/wiki/Alexander\">Alexander</a></td><td><a href=\"#/wiki/Edron\">Edron</a></td><td style=\"white-sp