 pi-data pi-item-spacing pi-border-color\" data-source=\"npcprice\">\n<h3 class=\"pi-data-label pi-secondary-font\">Bought for</h3>\n<div class=\"pi-data-value pi-font\">(not sold by NPCs)</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Field Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walkable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Blocking</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-cross\" title=\"No\">✗</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Utility Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Usable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\">6.5<br/><span class=\"implementation-date\">December 19, 2001</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: Objects<span class=\"explained\">Help</span></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-object-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20080124055247&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Snowball_9fb781.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"item-look tibiatext tibiagreen\">You see a snowball <span class=\"p-attributes\">(Atk:0, Def:0)</span>.<div class=\"p-weight\">It weighs 0.80 oz.</div><br/></div></div>\n<div class=\"\" id=\"w-twbox-sounds\"></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-object-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<p>It cannot be reused as they break after the first shot, therefore it is mostly used for decoration purposes.<br/>\nAt Christmas time, <a href=\"#/wiki/Santa%20Claus\">Santa Claus</a> may give them to you if you have been a good boy or girl. <br/>\nTheir value dropped significantly after <a href=\"#/wiki/Grynch%20Clan%20Goblin\">Grynch Clan Goblin</a> raids during Christmas.<br/>\nWhen snowballs are used as weapons, they don't do any damage.\nIt can be obtained through the <a href=\"#/quest/goblin-temple-quest\">Goblin Temple Quest</a>.\n</p>\n</div>\n<div id=\"w-object-proficiency\">\n<h3><span class=\"mw-headline\" id=\"w-Weapon_Proficiency\">Weapon Proficiency</span></h3>\n<div class=\"weapon_proficiency weapon_proficiency_border\">\n<table class=\"weapon_proficiency_number_table\">\n<tbody><tr>\n<td>1</td>\n<td>2</td>\n<td>3</td>\n<td>4</td>\n<td>5\n</td></tr>\n</tbody></table>\n<table class=\"weapon_proficiency_table\">\n<tbody><tr>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Ice Critical Hit Chance\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20250629110319&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Critical_Hit_Chance_Element_74a66f.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+0.50% critical extra hit chance for Ice spells and runes</div></div>\n<div><div class=\"weapon_proficiency_icon\" title=\"Ice Critical Ext