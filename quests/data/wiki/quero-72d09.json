"9\" loading=\"lazy\" src=\"assets/wiki/Gold_Icon_f66d4c.gif\" width=\"9\"/></span></span></span></td></tr><tr style=\"text-align:center\"><td><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Lute\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Lute_dbd554.gif\" width=\"32\"/></span></td><td>Lute</td><td style=\"white-space:nowrap\">195 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Gold\"><img alt=\"Gold\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Gold_Icon_f66d4c.gif\" width=\"9\"/></span></span></span></td></tr><tr style=\"text-align:center\"><td><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Lyre\"><img alt=\"Lyre\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Lyre_0589bc.gif\" width=\"32\"/></a></span></td><td><a href=\"#/wiki/Lyre\">Lyre</a></td><td style=\"white-space:nowrap\">120 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Gold\"><img alt=\"Gold\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Gold_Icon_f66d4c.gif\" width=\"9\"/></span></span></span></td></tr><tr style=\"text-align:center\"><td><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Simple Fanfare\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Simple_Fanfare_7bf48b.gif\" width=\"32\"/></span></td><td>Simple Fanfare</td><td style=\"white-space:nowrap\">150 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Gold\"><img alt=\"Gold\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Gold_Icon_f66d4c.gif\" width=\"9\"/></span></span></span></td></tr></tbody></table></div>\n<div style=\"clear:both;\"></div>\n</div>\n<div style=\"clear:both;\"></div>\n<div id=\"w-npc-transcripts\">\n<h3><span class=\"mw-headline\" id=\"w-Transcripts\">Transcripts</span></h3>\n<dl><dd><i>To change these transcripts, edit the transcripts page for Quero.</i></dd></dl>\n<div class=\"desktop-only\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"npc_chat_div\" width=\"100%\"><tbody><tr>\n<td style=\"width:7px;\"><div class=\"t1\" style=\"display:block;width:7px;height:24px;\"></div></td>\n<td style=\"width:107px;\"><div class=\"t2\" style=\"display:block;width:107px;height:24px;\"></div></td>\n<td style=\"width:100%;\"><div class=\"t3\" style=\"display:block;width:100%;height:24px;\"></div></td>\n<td style=\"width:7px;\"><div class=\"t4\" style=\"display:block;width:7px;height:24px;\"></div></td>\n</tr><tr class=\"m_tr\">\n<td class=\"m1\"></td>\n<td class=\"m2\" colspan=\"2\">\n<div class=\"m3\" style=\"overflow:auto;background:transparent;border:none;min-height:12px;height:100%;\">\n<p>\n<i>Player</i>: <b>hi</b><br/>\n<strong class=\"mw-selflink selflink\">Quero</strong>: Welcome <i>Player</i>! Can I help you?<br/>\n<i>Player</i>: <b>job</b><br/>\nQuero: I make instruments and sometimes I'm wandering through the lands of Tibia as a bard.<br/>\n<i>Player</i>: <b>instruments</b> or <b>offer</b><br/>\nQuero: You can buy a lyre, lute, drum, and simple fanfare.<br/>\n<i>Player</i>: <b>bard</b><br/>\nQuero: Selling instruments isn't enough to live on and I love music. That's why I wander through the lands from time to time.<br/>\n<i>Player</i>: <b>music</b><br/>\nQuero: I love the music of the elves.<br/>\n<i>Player</i>: <b>Elf</b><br/>\nQuero: They live in the northeast of Tibia.<br/>\n<i>Player</i>: <b>name</b><br/>\nQuero: My name is Quero.<br/>\n<i>Player</i>: <b>time</b><br/>\nQuero: Sorry, I don't know what time it is.<br/>\n<i>Player</i>: <b><a href=\"#/wiki/Benjamin\">Benjamin</a></b><br/>\n Quero: He's nice.<br/>\n<i>Player</i>: <b><a href=\"#/wiki/Eclesius\">Eclesius</a></b><br/>\n Quero: That name rings a bell, wait... I've last seen him several days ago when he went to buy some bread at the farm.<br/>\n<i>Player</i>: <b>bye</b><br/>\nQuero: Good bye.\n</p></div>\n</td>\n<td class=\"m4\"></td>\n</tr><tr>\n<td class=\"b1\" style=\"width:7px;\"><div style=\"display:block;width:7px;height:24px;\"></div></td>\n<td class=\"b2\" style=\"width:107px;\"><div style=\"display:block;width:107px;height:24px;\"></div></td>\n<td class=\"b3\" style=\"width:100%;\"><div style=\"display:block;width:100%;height:24px;\"></div></td>\n<td class=\"b4\" style=\"width:7px;\"><div style=\"display:block;width:7px;height:24px;\"></div></td>\n</tr>\n</tbody></table>\n<p><span><strong class=\"mw-selflink selflink\">Quero</strong></span>\n</p>\n</div>\n</div>\n</div></div>","quests":["threatened-dreams-quest"],"pos":{"x":32390,"y":32220,"z":7}}