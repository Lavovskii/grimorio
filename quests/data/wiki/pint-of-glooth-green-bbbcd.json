pacing pi-border-color\" data-source=\"npcvalue\">\n<h3 class=\"pi-data-label pi-secondary-font\">Sold for</h3>\n<div class=\"pi-data-value pi-font\">(not bought by NPCs)</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"npcprice\">\n<h3 class=\"pi-data-label pi-secondary-font\">Bought for</h3>\n<div class=\"pi-data-value pi-font\">(not sold by NPCs)</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Field Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walkable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Blocking</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-cross\" title=\"No\">✗</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Utility Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Usable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\">10.50<br/><span class=\"implementation-date\">July 7, 2014<br/>Summer Update 2014</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: Objects<span class=\"explained\">Help</span></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-object-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20180302000822&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Pint_of_Glooth_Green_525f55.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"item-look tibiatext tibiagreen\">You see a pint of glooth.<div class=\"p-weight\">It weighs 2.00 oz.</div><div class=\"p-flavortext\">Though it's green, it has quite a pleasant odour.</div><br/></div></div>\n<div class=\"\" id=\"w-twbox-sounds\"><span class=\"tibiatext tibiaorange\"><ul class=\"sound-list\"><li>Aaaand I knew a Mary who was fair and hairy, but one night she turned into a weeeerewooolf...</li></ul></span></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-object-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<p>This is an unused <a href=\"#/wiki/Pint%20of%20Glooth\">Pint of Glooth</a> that has been sitting idle for 10 minutes. If you don't use it, it will become a Pint of Glooth (Stale) after 10 minutes. You can consume this green pint of glooth by using it on your character. Upon doing so, your character will experience the Yellow Notes Effect <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Yellow Notes Effect\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Yellow_Notes_Effect_cf87f5.gif\" width=\"32\"/></span></span> and you'll sing.\n</p>\n</div>\n<p><br/>\n</p>\n<div style=\"clear:left;\"></div>\n<div id=\"w-item-droppedby\">\n<h3><span class=\"mw-headline\" id=\"w-Dropped_By\">Dropped By</span></h3>\n<div class=\"item-droppedby-wrapper\">\n<ul class=\"creature-list-generic no-results\"><li>This item is not dropped by any creatures.</li></ul>\n<div style=\"clear:left;\"></div>\n</div>\n</div>\n<div style=\"clear:both;\"></div>\n<div id=\"w-item-trades\">\n<h3 class=\"semantic-header\"><span class=\"mw-headline\" id=\"w-Trade_Details\">Trade Details</span></h3>\n<div class=\"trades\"><h4><span class=\"mw-headline\" id=\"w-Buy_From\">Buy From</span></h4><p class=\"no-results\">No NPC sells this item.</p></div>\n<div class=\"trades\"><h4><span class=\"mw-headline\" id=\"w-Sell_To\">Sell To</span></h4><p class=\"no-results\">No NPC buys this item.</p></div>\n</div>\n<div style=\"clear:both;\"></div>\n<div style=\"clear:both;\"></div>\n<div class=\"navigation\">\n<h3><span class=\"mw-headline\" id=\"w-Related_Pages\">Related Pages</span></h3>\n<div class=\"navigation-body navigation-list-wrapper\">\n<ul><li>Liquids</li><li><a href=\"#/quest/oramond-quest\">Oramond Quest</a></li><li><a href=\"#/wiki/Pint%20of%20Glooth\">Pint of Glooth</a></li><li>Pint of Glooth (Stale)</li><li>Status Effects</li><li>Yellow Notes Effect</li></ul>\n</div>\n</div></div></div>","quests":["oramond-quest"],"howto":{"quests":[{"slug":"oramond-quest","quest":"Oramond Quest","step":"8-8","n":94,"title":"Dr. Merlay's Misery: pedir a bebida","kind":"mention","coords":[{"x":33584,"y":31942,"z":7,"label":"Roswitha"}]}]}}