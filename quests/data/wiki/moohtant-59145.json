div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:85.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 15.0000%); display:inline-block;\">85%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.9500\" title=\"Fire\"><div class=\"creature-resistance-label\">Fire <span typeof=\"mw:File\"><span><img alt=\"Burning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Burning_Icon_Big_a56686.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:95.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 5.0000%); display:inline-block;\">95%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.8500\" title=\"Energy\"><div class=\"creature-resistance-label\">Energy <span typeof=\"mw:File\"><span><img alt=\"Electrified Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Electrified_Icon_Big_b60abe.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:85.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 15.0000%); display:inline-block;\">85%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Earth\"><div class=\"creature-resistance-label\">Earth <span typeof=\"mw:File\"><span><img alt=\"Poisoned Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Poisoned_Icon_Big_f04eb1.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div clas