i-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"exp\">Experience</th>\n<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"loot\">Loot</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"exp\"><p style=\"text-align: center; color: dodgerblue\"><b>Average</b></p><p style=\"text-align: center; margin: 0.4em 0 0.5em;\"><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><br/><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span></p></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"loot\"><p style=\"text-align: center; color: blueviolet\"><b>Average</b></p><p style=\"text-align: center; margin: 0.4em 0 0.5em;\"><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><br/><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span><span typeof=\"mw:File\"><img alt=\"Star1\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Star1_fd1ea6.png\" width=\"10\"/></span></p></td>\n</tr>\n</tbody>\n</table>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<table class=\"pi-horizontal-group pi-horizontal-group-no-labels\">\n<caption class=\"pi-header pi-secondary-font pi-secondary-background pi-item-spacing\">Notable Loot</caption>\n<tbody>\n<tr>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Wand%20of%20Cosmic%20Energy\"><img alt=\"Wand of Cosmic Energy\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Wand_of_Cosmic_Energy_8da6e8.gif\" width=\"32\"/></a></span></span></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot2\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Minotaur%20Trophy\"><img alt=\"Minotaur Trophy\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Minotaur_Trophy_60a414.gif\" width=\"32\"/></a></span></span></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot3\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Taurus Mace\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Taurus_Mace_ab9c8b.gif\" width=\"32\"/></span></span></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot4\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Double%20Axe\"><img alt=\"Double Axe\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Double_Axe_76f6d3.gif\" width=\"32\"/></a></span></span></td>\n<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"bestloot5\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Bear%20Paw\"><img alt=\"Bear Paw\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Bear_Paw_90f79b.gif\" width=\"32\"/></a></span></span></td>\n</tr>\n</tbody>\n</table>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"implementation-date\">6.61-6.97<br/>June 14, 2002</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\"><p>\t    See also: Hunting Places <span class=\"explained\">Help</span></p></nav>\n</aside>\n<p>The Kazordoon <a href=\"#/wiki/Minotaurs\">Minotaurs</a> are west of the city, just outside the <a href=\"#/wiki/Dwarf%20Mines\">Dwarf Mines</a>. The Minotaurs are led by <a href=\"#/wiki/The%20Horned%20Fox\">The Horned Fox</a>, who leads raids on the mines.<br/>\n</p><p>From the main entrance of <a href=\"#/wiki/Kazordoon\">Kazordoon</a> go from the red X mark in the top right, following the white line to a rope hole, here there are some <a href=\"#/wiki/Spider\">spiders</a>. Go north and exit down a ramp where there are <a href=\"#/wiki/Poison%20Spider\">Poison Spiders</a> and some <a href=\"#/wiki/Dwarf\">Dwarves</a> on the ground level. \n</p><p><span typeof=\"mw:File\"><img alt=\"Way to Minotaur Tower\" class=\"mw-file-element\" height=\"350\" loading=\"lazy\" src=\"assets/wiki/Way_to_Minotaur_Tower_51b3be.png\" width=\"500\"/></span>\n</p><p>Keep following the white line south across two bridges and past other mine entrances. You may encounter <a href=\"#/wiki/Snake\">Snakes</a>, <a href=\"#/wiki/Poison%20Spider\">Poison Spiders</a>, <a href=\"#/wiki/Wolf\">Wolves</a>, and <a href=\"#/wiki/Bear\">Bears</a>. Here use your <a href=\"#/wiki/Shovel\">shovel</a> on a <a href=\"#/wiki/Loose%20Stone%20Pile\">Loose Stone Pile</a> to go down.\n</p><p>On the <b>ground</b> level inside the tower are: 2 <a href=\"#/wiki/Minotaur%20Guard\">Minotaur Guards</a>, 2 <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a>.<br/>\nOutside, around the tower are 4 <a href=\"#/wiki/Minotaurs\">Minotaurs</a>.<br/>\nOutside the south entrance are 3 <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a>, <a href=\"#/wiki/Wolf\">Wolves</a>, <a href=\"#/wiki/Deer\">Deer</a>.\n</p>\n<table border=\"0\" cellpadding=\"5\" cellspacing=\"0\">\n<tbody><tr>\n<td><span typeof=\"mw:File\"><img alt=\"Kazordoon Minotaurs (-1)\" class=\"mw-file-element\" height=\"321\" loading=\"lazy\" src=\"assets/wiki/Kazordoon_Minotaurs_1_361490.png\" width=\"200\"/></span></td>\n<td><b>Underground -1</b> has many <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a>, <a href=\"#/wiki/Minotaur\">Minotaurs</a>, <a href=\"#/wiki/Bat\">Bats</a>.<br/><br/>\n<p>On the map: the red X mark is the way out towards <a href=\"#/wiki/Dwarf%20Mines\">Dwarf Mines</a><br/>\nThe northern up arrow mark leads to a dead end above ground with 3 <a href=\"#/wiki/Bear\">Bears</a> and some trees.<br/>\nThe second up arrow mark goes to the grassy area around the Minotaur Tower.<br/>\nThe third up arrow mark goes into the Minotaur Tower.<br/>\nThe fourth up arrow mark goes to the peninsula south of the mines, where there are some Archers and a way into <a href=\"#/wiki/Mount%20Sternum%2FUndead%20Cave\">Undead Caves</a>.\n</p>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><img alt=\"Kazordoon Minotaurs (-2)\" class=\"mw-file-element\" height=\"313\" loading=\"lazy\" src=\"assets/wiki/Kazordoon_Minotaurs_2_5c0518.png\" width=\"200\"/></span></td>\n<td><b>Underground -2</b> has many <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a>, <a href=\"#/wiki/Minotaur\">Minotaurs</a>, <a href=\"#/wiki/Bat\">Bats</a>.<br/>\n<p>The far south end has the teleport to <a href=\"#/wiki/The%20Horned%20Fox\">The Horned Fox</a>'s room, which is just south of it.\n</p>\n</td></tr></tbody></table>\n<p><br/>\n</p>\n<table border=\"0\" cellpadding=\"5\" cellspacing=\"0\">\n<tbody><tr>\n<td><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Kazordoon Minotaurs (+1)\" class=\"mw-file-element\" height=\"134\" loading=\"lazy\" src=\"assets/wiki/Kazordoon_Minotaurs_1_94c00d.png\" width=\"98\"/></span></td>\n<td><b>second</b>: 4 <a href=\"#/wiki/Minotaur%20Guard\">Minotaur Guards</a>, 4 <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a>\n</td></tr>\n<tr>\n<td><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Kazordoon Minotaurs (+2)\" class=\"mw-file-element\" height=\"139\" loading=\"lazy\" src=\"assets/wiki/Kazordoon_Minotaurs_2_ddfb0a.png\" width=\"96\"/></span></td>\n<td><b>third</b>: 2 <a href=\"#/wiki/Minotaur%20Guard\">Minotaur Guards</a> in each room (north and south rooms)\n</td></tr>\n<tr>\n<td><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Kazordoon Minotaurs (+3)\" class=\"mw-file-element\" height=\"128\" loading=\"lazy\" src=\"assets/wiki/Kazordoon_Minotaurs_3_6d66ef.png\" width=\"83\"/></span></td>\n<td><b>fourth</b>: North side: 2 <a href=\"#/wiki/Minotaur%20Guard\">Minotaur Guards</a>, 4 <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a><br/>\n<p>South side: 2 <a href=\"#/wiki/Minotaur%20Mage\">Minotaur Mages</a>, 4 <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a><br/>\n</p>\n</td></tr>\n<tr>\n<td><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Kazordoon Minotaurs (+4)\" class=\"mw-file-element\" height=\"108\" loading=\"lazy\" src=\"assets/wiki/Kazordoon_Minotaurs_4_1ac374.png\" width=\"77\"/></span></td>\n<td><b>fifth</b>: North side:4 <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a><br/>\n<p>South side: 1 <a href=\"#/wiki/Minotaur%20Mage\">Minotaur Mage</a>, 3 <a href=\"#/wiki/Minotaur%20Archer\">Minotaur Archers</a>\n</p>\n</td></tr></tbody></table>\n<p><br/>\n<a href=\"#/quest/iron-hammer-quest\">Iron Hammer Quest</a>, <a href=\"#/quest/to-outfox-a-fox-quest\">To Outfox a Fox Quest</a>, <a href=\"#/quest/steel-helmet-quest\">Steel Helmet Quest</a>, and <a href=\"#/wiki/Budrik\">Budrik</a>'s <a href=\"#/quest/killing-in-the-name-of-quest\">Killing in the Name of... Quest</a> mission to kill 5000 <a href=\"#/wiki/Minotaurs\">Minotaurs</a> and <a href=\"#/wiki/The%20Horned%20Fox\">The Horned Fox</a>.<br/>\nIn the first floor underground, going all the way north, up a rope hole, and around the mountain leads to a <a href=\"#/wiki/Dead%20Tree\">Dead Tree</a> that contains the <a href=\"#/wiki/Key%203899\">Key 3899</a> to <a href=\"#/wiki/Paradox%20Tower\">Paradox Tower</a>.\n</p>\n<div style=\"clear:both;\"></div>\n<div style=\"clear:both;\"></div><table cellspacing=\"0\" class=\"wikitable sortable full-width\"><caption>Creatures ground level (outside tower)</caption><tbody><tr><th>Name</th><th data-sort-type=\"number\" style=\"width: 38px; text-align: center;\">Exp</th><th data-sort-type=\"number\" style=\"text-align: center;\">HP</th><th data-sort-type=\"number\" style=\"text-align: center;\">Max. Damage</th><th style=\"font-size: small;\">Loot</th></tr>\n<tr><td style=\"width: 100px; text-align: center\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Deer\"><img alt=\"Deer\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Deer_8cd0d3.gif\" width=\"32\"/></a></span></span><br/><a href=\"#/wiki/Deer\">Deer</a></td><td style=\"width: 38px; text-align: center;\">0</td><td style=\"text-align: center;\">25</td><td style=\"text-align: center;\"><span style=\"white-space: nowrap\">1 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Physical%20Damage\"><img alt=\"Physical Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Physical_Damage_Icon_356411.gif\" width=\"9\"/></a></span></span></span></td><td style=\"font-size: small;\"><div class=\"loot-table\" id=\"w-loot_perc_loot\">\n<ul><li>1-4× <a href=\"#/wiki/Meat\">Meat</a> (common)</li>\n<li><a href=\"#/wiki/Ham\">Ham</a> (common)</li>\n<li><a href=\"#/wiki/Antlers\">Antlers</a> (rare)</li>\n</ul>\n</div></td></tr><tr><td style=\"width: 100px; text-align: center\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Snake\"><img alt=\"Snake\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Snake_193217.gif\" width=\"32\"/></a></span></span><br/><a href=\"#/wiki/Snake\">Snake</a></td><td style=\"width: 38px; text-align: center;\">10</td><td style=\"text-align: center;\">15</td><td style=\"text-align: center;\">9 (<span style=\"white-space: nowrap\">8 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Physical%20Damage\"><img alt=\"Physical Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Physical_Damage_Icon_356411.gif\" width=\"9\"/></a></span></span></span>, <span style=\"white-space: nowrap\">1 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Earth Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Poisoned_Icon_7605e0.gif\" width=\"9\"/></span></span></span>)</td><td style=\"font-size: small;\"><div class=\"loot-table no-results\" id=\"w-loot_perc_loot\">\n<ul><li>This creature drops no loot.</li>\n</ul>\n</div></td></tr><tr><td style=\"width: 100px; text-align: center\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Spider\"><img alt=\"Spider\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Spider_7e449e.gif\" width=\"32\"/></a></span></span><br/><a href=\"#/wiki/Spider\">Spider</a></td><td style=\"width: 38px; text-align: center;\">12</td><td style=\"text-align: center;\">20</td><td style=\"text-align: center;\"><span style=\"white-space: nowrap