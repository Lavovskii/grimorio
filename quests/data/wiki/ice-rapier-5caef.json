ta pi-item-spacing pi-border-color\" data-source=\"npcprice\">\n<h3 class=\"pi-data-label pi-secondary-font\">Bought for</h3>\n<div class=\"pi-data-value pi-font\">5,000 gp</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Field Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walkable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Blocking</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-cross\" title=\"No\">✗</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Utility Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Usable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\">5.0<br/><span class=\"implementation-date\">June 18, 1999<br/>Beta 5.0</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: Objects<span class=\"explained\">Help</span></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-object-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20191203162029&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Ice_Rapier_7805e9.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"item-look tibiatext tibiagreen\">You see an ice rapier <span class=\"p-attributes\">(Atk:42 physical +18 ice, Def:1)</span>.<div class=\"p-weight\">It weighs 15.00 oz.</div><div class=\"p-flavortext\">A deadly but fragile weapon.</div><br/></div></div>\n<div class=\"\" id=\"w-twbox-sounds\"></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-object-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<p>Once it used to be the strongest sword weapon in the game (Atk:100), but also very fragile. It will break with the first hit (even when used while casting spells such as Exori or Whirlwind throw. It is usually being used as decoration rather than in actual fights. The attack value now consists of 42 physical and 18 ice damage.\n</p>\n</div>\n<div id=\"w-object-proficiency\">\n<h3><span class=\"mw-headline\" id=\"w-Weapon_Proficiency\">Weapon Proficiency</span></h3>\n<div class=\"weapon_proficiency weapon_proficiency_border\">\n<table class=\"weapon_proficiency_number_table\">\n<tbody><tr>\n<td>1</td>\n<td>2</td>\n<td>3</td>\n<td>4</td>\n<td>5</td>\n<td>6\n</td></tr>\n</tbody></table>\n<table class=\"weapon_proficiency_table\">\n<tbody><tr>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Extra Damage\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+5% critical extra damage for auto-attacks</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Extra Damage\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+10% critical extra damage for auto-attacks</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Extra Damage\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+15% critical extra damage for auto-attacks</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Hit Chance\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+15% critical hit chance for auto-attacks</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Hit Chance\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+30% critical hit chance for auto-attacks</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Hit Chance\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+50% critical hit chance for auto-attacks</div></div></div>\n</td></tr>\n</tbody></table>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div class=\"history-section\" id=\"w-object-history\">\n<h3><span class=\"mw-headline\" id=\"w-History\">History</span></h3>\n<p>Before the 8.0 Update, this sword weapon had an attack of 100 (Atk: 100). During this update, it was downgraded to Atk: 60.\n</p><p>Before the current quest system was implemented, this sword spawned daily on the casket where the current <a href=\"#/quest/noble-armor-quest\">Noble Armor Quest</a> is.\n</p>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-item-droppedby\">\n<h3><span class=\"mw-headline\" id=\"w-Dropped_By\">Dropped By</span></h3>\n<div class=\"item-droppedby-wrapper\">\n<ul><li><a href=\"#/wiki/Afflicted%20Strider\">Afflicted Strider</a></li>\n<li><a href=\"#/wiki/Angry%20Demon\">Angry Demon</a></li>\n<li><a href=\"#/wiki/Animated%20Snowman\">Anima