1px 1px 1px; width:99.0099%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 0.9901%); display:inline-block;\">100%?</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Healing\"><div class=\"creature-resistance-label\">Healing <span typeof=\"mw:File\"><span><img alt=\"Healing Icon\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Healing_Icon_be4df6.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:99.0099%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 0.9901%); display:inline-block;\">100%?</div></div></div>\n</div><div style=\"clear:left;\"></div>\n</div>\n<div id=\"w-creature-location\">\n<h3><span class=\"mw-headline\" id=\"w-Location\">Location</span></h3>\n<p>In the <a href=\"#/wiki/Svargrond%20Arena\">Svargrond Arena</a>.\n</p>\n</div>\n<div id=\"w-creature-behaviour\">\n<h3><span class=\"mw-headline\" id=\"w-Behaviour\">Behaviour</span></h3>\n<p>\tA spirit of fire attacks in melee range. A spirit of fire never retreats.\n</p>\n</div>\n<div id=\"w-creature-strategy\">\n<h3><span class=\"mw-headline\" id=\"w-Strategy\">Strategy</span></h3>\n<p>\tIt's <b>Recommended</b> to use <a href=\"#/wiki/Protection%20Amulet\">Protection Amulet</a> to reduce physical damages.<br/>Druid or Sorcerer:  Use <a href=\"#/wiki/Magic%20Shield\">Magic Shield</a> and shoot SD as fast as you can if your level is lower than 50. If your level is 45 or lower use 1 to 4 SSA to make mana last longer since almost all the damage you take is melee.\nAt level 70 or higher you can use <a href=\"#/wiki/Ice%20Strike\">Ice Strike</a> and Exura.<br/>Knight: Use melee and Exori and <a href=\"#/wiki/Strong%20Health%20Potion\">Strong Health Potions</a>. Make sure your health is always high because this boss can take even experienced knights down with big combos. <br/>Paladin: Use Shield, <a href=\"#/wiki/Ethereal%20Spear\">Ethereal Spear</a> and maybe even <a href=\"#/wiki/Icicle%20Rune\">Icicle</a> to kill him fast.\n</p>\n</div>\n<div style=\"clear:both;\"></div>\n<div>\n<h3><span class=\"mw-headline\" id=\"w-Loot\">Loot</span></h3>\n<p><i>There is no loot data for this creature. Please consider subtmitting loot logs for this creature using the Loot Statistics parser.</i>\n</p>\n</div>\n<div style=\"clear:both;\"></div>\n<div class=\"navigation\">\n<h3><span class=\"mw-headline\" id=\"w-Related_Creatures\">Related Creatures</span></h3>\n<div class=\"navigation-body\">\n<h4><span class=\"mw-headline\" id=\"w-Pyro-Elementals\">Pyro-Elementals</span></h4>\n<div class=\"navigation-list-wrapper\"><ul><li><a href=\"#/wiki/Blasting%20Flame\">Blasting Flame</a></li><li><a href=\"#/wiki/Blazing%20Fire%20Elemental\">Blazing Fire Elemental</a></li><li><a href=\"#/wiki/Blistering%20Fire%20Elemental\">Blistering Fire Elemental</a></li><li><a href=\"#/wiki/Deadly%20Heat\">Deadly Heat</a></li><li><a href=\"#/wiki/Excess%20Heat\">Excess Heat</a></li><li><a href=\"#/wiki/Fiery%20Blood\">Fiery Blood</a></li><li><a href=\"#/wiki/Fire%20Elemental\">Fire Elemental</a></li><li><a href=\"#/wiki/Fire%20Overlord\">Fire Overlord</a></li><li><a href=\"#/wiki/Fireling\">Fireling</a></li><li><a href=\"#/wiki/Flame%20of%20Omrafir\">Flame of Omrafir</a></li><li><a href=\"#/wiki/Furious%20Fire%20Elemental\">Furious Fire Elemental</a></li><li><a href=\"#/wiki/Greater%20Fire%20Elemental\">Greater Fire Elemental</a></li><li><a href=\"#/wiki/Hellfire%20Fighter\">Hellfire Fighter</a></li><li><a href=\"#/wiki/Herald%20of%20Fire\">Herald of Fire</a></li><li><a href=\"#/wiki/Incineron\">Incineron</a></li><li><a href=\"#/wiki/Infernoid%20Blob\">Infernoid Blob</a></li><li><a href=\"#/wiki/Infernoid%20Hound\">Infernoid Hound</a></li><li><a href=\"#/wiki/Infernoi