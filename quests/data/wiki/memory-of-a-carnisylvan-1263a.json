\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Earth Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Poisoned_Icon_7605e0.gif\" width=\"9\"/></span></span> Poison Ball</span> (130-180)</div></div>\n<div style=\"clear:left;\"></div>\n</div>\n<div class=\"mobile-hide\" id=\"w-creature-resistance-table\">\n<h3><span class=\"mw-headline\" id=\"w-Damage_Taken_From_Elements\">Damage Taken From Elements</span></h3>\n<div id=\"w-creature-resistance-d\">\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Physical\"><div class=\"creature-resistance-label\">Physical <span typeof=\"mw:File\"><span><img alt=\"Bestiary Physical Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Physical_Icon_Big_83da43.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:86.9565%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 13.0435%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.9500\" title=\"Death\"><div class=\"creature-resistance-label\">Death <span typeof=\"mw:File\"><span><img alt=\"Cursed Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Cursed_Icon_Big_de8a1f.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:82.6087%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 17.3913%); display:inline-block;\">95%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Holy\"><div class=\"creature-resistance-label\">Holy <span typeof=\"mw:File\"><span><img alt=\"Dazzled Ic