{"t":"Wasp","s":"wasp-5a212","k":"creature","i":"assets/wiki/Wasp_0ca50d.gif","q":29,"html":"<div class=\"mw-content-ltr mw-parser-output\" dir=\"ltr\" lang=\"en\"><div class=\"twbox\">\n<aside class=\"portable-infobox pi-background pi-border-color pi-theme-twbox pi-layout-default\" role=\"region\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\">Wasp</h2>\n<figure class=\"pi-item pi-image\">\n<img alt=\"Wasp\" class=\"pi-image-thumbnail\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Wasp_0ca50d.gif\" width=\"32\"/>\n</figure>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Combat Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"hp\">\n<h3 class=\"pi-data-label pi-secondary-font\">Health</h3>\n<div class=\"pi-data-value pi-font\">35 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Health\"><img alt=\"Health\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Health_Icon_4142d2.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"exp\">\n<h3 class=\"pi-data-label pi-secondary-font\">Experience</h3>\n<div class=\"pi-data-value pi-font\">24 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Experience\"><img alt=\"Experience\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Experience_Icon_12adf8.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiarylevel\">\n<h3 class=\"pi-data-label pi-secondary-font\">Animus</h3>\n<div class=\"pi-data-value pi-font\">24~25 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Experience\"><img alt=\"Experience\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Experience_Icon_12adf8.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"speed\">\n<h3 class=\"pi-data-label pi-secondary-font\">Speed</h3>\n<div class=\"pi-data-value pi-font\">160 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Speed\"><img alt=\"Speed\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Haste_Icon_105a69.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"armor\">\n<h3 class=\"pi-data-label pi-secondary-font\">Armor</h3>\n<div class=\"pi-data-value pi-font\">4 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Armor\"><img alt=\"Armor\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Armor_Icon_c70b3b.gif\" width=\"9\"/></span></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"mitigation\">\n<h3 class=\"pi-data-label pi-secondary-font\">Mitigation</h3>\n<div class=\"pi-data-value pi-font\">0.32% <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Mitigation\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Mitigation_Icon_7ae0f5.png\" width=\"9\"/></span></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"maxdmg\">\n<h3 class=\"pi-data-label pi-secondary-font\">Est. Max Dmg</h3>\n<div class=\"pi-data-value pi-font\"><span style=\"white-space: nowrap\">20 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Physical%20Damage\"><img alt=\"Physical Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Physical_Damage_Icon_356411.gif\" width=\"9\"/></a></span></span></span><br/>+ 2 <span class