;\"></div></td>\n<td style=\"width:107px;\"><div class=\"t2\" style=\"display:block;width:107px;height:24px;\"></div></td>\n<td style=\"width:100%;\"><div class=\"t3\" style=\"display:block;width:100%;height:24px;\"></div></td>\n<td style=\"width:7px;\"><div class=\"t4\" style=\"display:block;width:7px;height:24px;\"></div></td>\n</tr><tr class=\"m_tr\">\n<td class=\"m1\"></td>\n<td class=\"m2\" colspan=\"2\">\n<div class=\"m3\" style=\"overflow:auto;background:transparent;border:none;min-height:12px;height:100%;\">\n<p>\nYanni: Salutations, <i>Player</i>. Welcome to the Ironhouse, {warehouse} of Abran Ironeye.<br/>\n<i>Player</i>: <b>warehouse</b><br/>\nYanni: If you'd like to see my offers in armor, ask me for a trade.<br/>\n<i>Player</i>: <b>trade</b><br/>\nYanni: Of course, just browse through my wares.<br/>\n<i>Player</i>: <b>job</b><br/>\nYanni: I work for Abran Ironeye in the armor department.<br/>\n<i>Player</i>: <b>name</b><br/>\nYanni: My name is Yanni.<br/>\n<i>Player</i>: <b>Abran Ironeye</b><br/>\nYanni: A very hard boss, but if you ever talk to him, tell him I said he's a great man.<br/>\n<i>Player</i>: <b>news</b><br/>\nYanni: I know nothing of interest.<br/>\n<i>Player</i>: <b>excalibug</b><br/>\nYanni: I don't believe in the excalibug myth.<br/>\n<i>Player</i>: <b>armor</b><br/>\nYanni: If you'd like to see which armors I buy and sell, ask me for a trade.<br/>\n<i>Player</i>: <b>bye</b><br/>\nYanni: Thanks for doing business with us, traveller <i>Player</i>!\n</p></div>\n</td>\n<td class=\"m4\"></td>\n</tr><tr>\n<td class=\"b1\" style=\"width:7px;\"><div style=\"display:block;width:7px;height:24px;\"></div></td>\n<td class=\"b2\" style=\"width:107px;\"><div style=\"display:block;width:107px;height:24px;\"></div></td>\n<td class=\"b3\" style=\"width:100%;\"><div style=\"display:block;width:100%;height:24px;\"></div></td>\n<td class=\"b4\" style=\"width:7px;\"><div style=\"display:block;width:7px;height:24px;\"></div></td>\n</tr>\n</tbody></table>\n<p><span><strong class=\"mw-selflink selflink\">Yanni</strong></span>\n</p>\n</div>\n</div>\n</div></div>","quests":[],"pos":{"x":32909,"y":32111,"z":6}}