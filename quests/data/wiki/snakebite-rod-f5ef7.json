border-color\" data-source=\"npcvalue\">\n<h3 class=\"pi-data-label pi-secondary-font\">Sold for</h3>\n<div class=\"pi-data-value pi-font\">100 gp</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"npcprice\">\n<h3 class=\"pi-data-label pi-secondary-font\">Bought for</h3>\n<div class=\"pi-data-value pi-font\">500 gp</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Field Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"walkable\">\n<h3 class=\"pi-data-label pi-secondary-font\">Blocking</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"no-cross\" title=\"No\">✗</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\">7.6<br/><span class=\"implementation-date\">December 12, 2005<br/>Christmas Update 2005</span></div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: Objects<span class=\"explained\">Help</span></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-object-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20150120030027&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Snakebite_Rod_b2ea6a.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"item-look tibiatext tibiagreen\">You see a snakebite rod.<br/>Classification: 1 Tier: 0.<div class=\"p-reqs\">It can only be wielded properly by druids of level 6 or higher.<br/></div><div class=\"p-weight\">It weighs 19.00 oz.</div><div class=\"p-flavortext\">It seems to twitch and quiver as if trying to escape your grip.</div><br/></div></div>\n<div class=\"\" id=\"w-twbox-sounds\"><span class=\"tibiatext tibiaorange\"><ul class=\"sound-list\"></ul></span></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-object-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<p>The <a href=\"#/wiki/Druid\">druid</a>'s equivalent of the <a href=\"#/wiki/Sorcerer\">sorcerer</a>'s <a href=\"#/wiki/Wand%20of%20Vortex\">Wand of Vortex</a> and the lowest-levelled rod available on the mainland. A rather ineffective weapon, as a lot of monsters, even the weakest, are resistant or outright immune to earth damage. Snakebite Rods replaced <span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Golden Wand\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Golden_Wand_d29a87.gif\" width=\"32\"/></span></span> Golden Wands in the Winter Update 2005.<br/>\nNeeded for <a href=\"#/quest/mage-outfits-quest\">Mage Outfits Quest</a> (male) and <a href=\"#/quest/summoner-outfits-quest\">Summoner Outfits Quest</a> (female).\n</p>\n</div>\n<div id=\"w-object-proficiency\">\n<h3><span class=\"mw-headline\" id=\"w-Weapon_Proficiency\">Weapon Proficiency</span></h3>\n<div class=\"weapon_proficiency weapon_proficiency_border\">\n<table class=\"weapon_proficiency_number_table\">\n<tbody><tr>\n<td>1</td>\n<td>2</td>\n<td>3\n</td></tr>\n</tbody></table>\n<table class=\"weapon_proficiency_table\">\n<tbody><tr>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Auto-Attack Critical Hit Chance\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+2% critical hit chance for auto-attacks</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Life Gain on Kill\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20251104183605&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_General_ed04f0.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+5 hit points on kill</div></div>\n<div><div class=\"weapon_proficiency_icon\" title=\"Magic Percentage Spell Healing\">\n<div></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img32\"><img alt=\"32?cb=20250629110322&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Gain_Extra_Healing_Spells_e39b25.png\"/></div>\n</div><div class=\"weapon_proficiency_text weapon_proficiency_border\">+10% of your Magic Level as extra healing for your spells</div></div></div>\n</td>\n<td><div class=\"weapon_proficiency_block weapon_proficiency_border\"><div><div class=\"weapon_proficiency_icon\" title=\"Spell Damage Perk\">\n<div><img alt=\"16?cb=20250625080425&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Skillwheel_Small_Perk_Icons_a3449f.png\"/></div>\n<div><img alt=\"latest?cb=20250625211543&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Weapon_Proficiency_Border_Active_417a88.png\"/></div>\n<div class=\"img38\"><img alt=\"38?cb=20101209161158&amp;path-prefix=en&amp;format=ori