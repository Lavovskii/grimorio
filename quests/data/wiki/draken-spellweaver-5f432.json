>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiarylevel\">\n<h3 class=\"pi-data-label pi-secondary-font\">Difficulty</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Hard\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Level_Hard_998887.gif\" width=\"57\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Occurrence</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Common\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Occurrence_Common_bbcd9e.gif\" width=\"46\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Charm Points</h3>\n<div class=\"pi-data-value pi-font\">50 <span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Charm Icon\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Charm_Icon_d968ed.gif\" width=\"11\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Kills to Unlock</h3>\n<div class=\"pi-data-value pi-font\">2500</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"attacktype\">\n<h3 class=\"pi-data-label pi-secondary-font\">Behaviour</h3>\n<div class=\"pi-data-value pi-font\"><span title=\"Creature attacks in melee range\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Logout Block Icon\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Logout_Block_Icon_8f2784.gif\" width=\"9\"/></span></span></span> <span title=\"Creature casts spells or uses skills\"><span class=\"mw-default-siz