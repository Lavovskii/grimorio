ader\"><span class=\"mw-headline\" id=\"w-Trade_Details\">Trade Details</span></h3>\n<div class=\"trades\"><h4><span class=\"mw-headline\" id=\"w-Buy_From\">Buy From</span></h4><p class=\"no-results\">No NPC sells this item.</p></div>\n<div class=\"trades\"><h4><span class=\"mw-headline\" id=\"w-Sell_To\">Sell To</span></h4><p class=\"no-results\">No NPC buys this item.</p></div>\n</div>\n<div style=\"clear:both;\"></div>\n<div style=\"clear:both;\"></div>\n<div class=\"navigation\">\n<h3><span class=\"mw-headline\" id=\"w-Related_Pages\">Related Pages</span></h3>\n<div class=\"navigation-body navigation-list-wrapper\">\n<ul><li>Documents and Papers</li><li>Duplicate Sprites</li><li>Other Objects</li><li>Part of a Map</li><li><a href=\"#/wiki/Plan\">Plan</a></li><li><a href=\"#/wiki/Quest%20Items\">Quest Items</a></li><li><a href=\"#/quest/treasure-hunt-quest\">Treasure Hunt Quest</a></li><li><a href=\"#/wiki/Treasure%20Map\">Treasure Map</a></li><li><a href=\"#/wiki/Treasure%20Map%20%28Pirate%29\">Treasure Map (Pirate)</a></li></ul>\n</div>\n</div></div></div>","quests":["treasure-hunt-quest"],"howto":{"quests":[{"slug":"treasure-hunt-quest","quest":"Treasure Hunt Quest","step":"2-5","n":13,"title":"Juntar o mapa","kind":"mention","coords":[{"x":31979,"y":32827,"z":2,"label":"Klaus"}]}]}}