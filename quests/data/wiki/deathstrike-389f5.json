i-data pi-item-spacing pi-border-color\" data-source=\"cooldown\">\n<h3 class=\"pi-data-label pi-secondary-font\">Cooldown</h3>\n<div class=\"pi-data-value pi-font\">20 hours</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Bosstiary Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bosstiaryclass\">\n<h3 class=\"pi-data-label pi-secondary-font\">Category</h3>\n<div class=\"pi-data-value pi-font\"> <span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Archfoe (5/20/60 kills to unlock)\" class=\"mw-file-element\" height=\"15\" loading=\"lazy\" src=\"assets/wiki/Bosstiary_Archfoe_Icon_b73cab.png\" width=\"15\"/></span> Archfoe</div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Immunity Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"paraimmune\">\n<h3 class=\"pi-data-label pi-secondary-font\">Paralysable</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"question-tick\" title=\"Unknown\">?</span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"senseinvis\">\n<h3 class=\"pi-data-label pi-secondary-font\">Sense Invis</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"question-tick\" title=\"Unknown\">?</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Behavioural Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"runsat\">\n<h3 class=\"pi-data-label pi-secondary-font\">Runs At</h3>\n<div class=\"pi-data-value pi-font\">2000 <span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Health\"><img alt=\"Health\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Health_Icon_4142d2.gif\" width=\"9\"/></span></span></span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Other Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"implemented\">\n<h3 class=\"pi-data-label pi-secondary-font\">Version</h3>\n<div class=\"pi-data-value pi-font\"><a href=\"#/wiki/Updates%2F9.60\">9.60</a><br/><span class=\"implementation-date\">July 11, 2012<br/>Summer Update 2012</span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"status\">\n<h3 class=\"pi-data-label pi-secondary-font\">Status</h3>\n<div class=\"pi-data-value pi-font\">Active</div>\n</div>\n</section>\n<nav class=\"pi-navigation pi-item-spacing pi-secondary-font\">See also: <a href=\"#/wiki/Creatures\">Creatures</a></nav>\n</aside>\n<div id=\"w-twbox-intro\">\n<div id=\"w-item-profile\">\n<div id=\"w-twbox-image\"><img alt=\"latest?cb=20120627165033&amp;path-prefix=en&amp;format=original\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Deathstrike_114169.gif\"/></div>\n<div id=\"w-twbox-look\"><div class=\"creature-look tibiatext tibiagreen\">You see  Deathstrike.</div></div>\n<div class=\"\" id=\"w-twbox-sounds\"><span class=\"tibiatext tibiaorange\"><ul class=\"sound-list\"><li>Deeestructiooon!</li><li>Maaahhhrrr!</li><li>I am carnage incarnate!</li><li>I've seen the light! And it was all engulfing fire!</li><li>Taaake... this!</li></ul></span></div>\n</div>\n</div>\n<div style=\"clear:left;\"></div>\n<div id=\"w-creature-notes\">\n<h3><span class=\"mw-headline\" id=\"w-Notes\">Notes</span></h3>\n<p>He is an overgrown <a href=\"#/wiki/Stone%20Devourer\">Stone Devourer</a>.\n</p>\n<div style=\"clear:left;\"></div>\n</div>\n<div id=\"w-creature-abilities\">\n<h3><span class=\"mw-headline\" id=\"w-Abilities\">Abilities</span></h3>\n<div class=\"ability_list\"><div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Physical%20Damage\"><img alt=\"Physical Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Physical_Damage_Icon_356411.gif\" width=\"9\"/></a></span></span> Melee</span> (0-2000)</div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Mana%20Drain\"><img alt=\"Mana Drain\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Mana_Drain_Icon_a3e6f8.gif\" width=\"9\"/></a></span></span> Mana Drain Wave</span> (200-500)</div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Energy Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Electrified_Icon_9e8d1e.gif\" width=\"9\"/></span></span> Energy Missile</span> (200-500)</div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Invisibility\"><img alt=\"Invisibility\" class=\"mw-file-element\" height=\"11\" loading=\"lazy\" src=\"assets/wiki/Invisible_Icon_ab037d.gif\" width=\"11\"/></span></span></span> <a href=\"#/wiki/Invisible\">Invisible</a></span></div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Fire%20Damage\"><img alt=\"Fire Damage\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Fire_Damage_Icon_7ba5fe.gif\" width=\"9\"/></a></span></span> Fire Beam</span> (500-1000)</div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Missing Element\" class=\"mw-file-element\" height=\"13\" loading=\"lazy\" src=\"assets/wiki/Question_Mark_Icon_e8125e.png\" width=\"8\"/></span></span> Thunderstorm</span> (400-600)</div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Slowed\"><img alt=\"Paralyze\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Slowed_Icon_942885.gif\" width=\"9\"/></a></span></span> Dizziness Bomb</span> (paralysis)</div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Healing\"><img alt=\"Healing\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Healing_Icon_be4df6.gif\" width=\"9\"/></span></span></span> Self-Healing</span> (often 1500-3500+)</div>⁠, <div class=\"creatureAbility\"><span style=\"white-space: nowrap\"><span class=\"icon\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span title=\"Healing\"><img alt=\"Healing\" class=\"mw-file-element\" height=\"9\" loading=\"lazy\" src=\"assets/wiki/Healing_Icon_be4df6.gif\" width=\"9\"/></span></span></span> strong Self-Healing</span> (rare 15000-23000+)</div></div>\n<div style=\"clear:left;\"></div>\n</div>\n<div class=\"mobile-hide\" id=\"w-creature-resistance-table\">\n<h3><span class=\"mw-headline\" id=\"w-Damage_Taken_From_Elements\">Damage Taken From Elements</span></h3>\n<div id=\"w-creature-resistance-d\">\n<div class=\"creature-resistance-el\" data-value=\"0.7500\" title=\"Physical\"><div class=\"creature-resistance-label\">Physical <span typeof=\"mw:File\"><span><img alt=\"Bestiary Physical Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Physical_Icon_Big_83da43.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:75.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 25.0000%); display:inline-block;\">75%&gt;?</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.6000\" title=\"Death\"><div class=\"creature-resistance-label\">Death <span typeof=\"mw:File\"><span><img alt=\"Cursed Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Cursed_Icon_Big_de8a1f.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:60.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 40.0000%); display:inline-block;\">60%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.8000\" title=\"Holy\"><div class=\"creature-resistance-label\">Holy <span typeof=\"mw:File\"><span><img alt=\"Dazzled Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Dazzled_Icon_Big_546495.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:80.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 20.0000%); display:inline-block;\">80%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.6000\" title=\"Ice\"><div class=\"creature-resistance-label\">Ice <span typeof=\"mw:File\"><span><img alt=\"Freezing Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Freezing_Icon_Big_4dcec8.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:60.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 40.0000%); display:inline-block;\">60%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.5000\" title=\"Fire\"><div class=\"creature-resistance-label\">Fire <span typeof=\"mw:File\"><span><img alt=\"Burning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Burning_Icon_Big_a56686.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:50.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 50.0000%); display:inline-block;\">50%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.6000\" title=\"Energy\"><div class=\"creature-resistance-label\">Energy <span typeof=\"mw:File\"><span><img alt=\"Electrified Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Electrified_Icon_Big_b60abe.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:60.0000%; background-color:#d0bd56; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 40.0000%); display:inline-block;\">60%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Earth\"><div class=\"creature-resistance-label\">Earth <span typeof=\"mw:File\"><span><img alt=\"Poisoned Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Poisoned_Icon_Big_f04eb1.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 0 1px 1px; width:0.0000%; background-color:#ff3333; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; left:calc(5px + 100% * 0.0000); display:inline-block;\">0%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Drown\"><div class=\"creature-resistance-label\">Drown <span typeof=\"mw:File\"><span><img alt=\"Drowning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Drowning_Icon_Big_f65e47.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:100.0000%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 0.0000%); display:inline-block;\">100%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Healing\"><div class=\"creature-resistance-label\">Healing <span typeof=\"mw:File\"><span><img alt=\"Healing Icon\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Healing_Icon_be4df6.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:100.0000%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 0.0000%); display:inline-block;\">100%?</div></div></div>\n</div><div style=\"clear:left;\"></div>\n</div>\n<div id=\"w-creature-location\">\n<h3><span class=\"mw-headline\" id=\"w-Location\">Location</span></h3>\n<p><a href=\"#/wiki/Warzone%201\">Warzone 1</a>\n</p>\n</div>\n<div id=\"w-creature-behaviour\">\n<h3><span class=\"mw-headline\" id=\"w-Behaviour\">Behaviour</span></h3>\n<p>\tHeals and goes invisible very often. Deathstrike will retreat at 2000  (1%, deep red) health.\n</p>\n</div>\n<div id=\"w-creature-strategy\">\n<h3><span class=\"mw-headline\" id=\"w-Strategy\">Strategy</span></h3>\n<p>\tTrap him in a corner and have your team shower him with <a href=\"#/wiki/Sudden%20Death%20Rune\">Sudden Death Runes</a>.  Sorcerers should rotate energy beams &amp; waves, along with sudden deaths. It is recommended to bring a team with 10 players at least. Good tip is for druid and sorcerer to do summon of fire elemental and fire devil for some more damage.\n</p>\n</div>\n<div style=\"clear:left;\"></div>\n<div class=\"history-section\" id=\"w-creature-history\">\n<h3><span class=\"mw-headline\" id=\"w-History\">History</span></h3>\n<ul><li>As announced on April 23, 2024, the patch increased its experience from 35,000 to 400,000 as part of the 2024 Balancing Project.</li>\n<li>As announced on May 14, 2024, the patch its loot is now cooperative as part of the 2024 Balancing Project.</li></ul>\n</div>\n<div style=\"clear:both;\"></div>\n<div>\n<h3><span class=\"mw-headline\" id=\"w-Loot\">Loot</span></h3>\n<p><small><i>Drop rates are estimated based on 11 samples <span class=\"loot-stats-link\">(Loot Statistics)</span>.</i></small> <small><i>Colour-coding is applied after 50 samples — current sample size is below this threshold.</i></small><br/><small><i>Task column indicates items used in delivery tasks.</i></small>\n</p>\n<table class=\"wikitable sortable\" style=\"text-align:center; width:auto;\">\n<tbody><tr>\n<th></th>\n<th>Item</th>\n<th>Task</th>\n<th>Quantity</th>\n<th>Avg</th>\n<th data-sort-type=\"number\">%\n</th></tr>\n<tr>\n<td><span class=\"loot-table-icon\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Deathstrike%27s%20Snippet\"><img alt=\"Deathstrike's Snippet\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Deathstrike_s_Snippet_4d9faf.gif\" width=\"32\"/></a></span></span></span></td>\n<td><a href=\"#/wiki/Deathstrike%27s%20Snippet\">Deathstrike's Snippet</a></td>\n<td></td>\n<td>1</td>\n<td>1.0</td>\n<td class=\"\" data-sort-value