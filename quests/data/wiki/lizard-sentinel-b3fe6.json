class=\"pi-data-value pi-font\"><span class=\"yes-tick\" title=\"Yes\">✓</span></div>\n</div>\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Bestiary Properties</h2>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiaryclass\">\n<h3 class=\"pi-data-label pi-secondary-font\">Class</h3>\n<div class=\"pi-data-value pi-font\">Reptile</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"bestiarylevel\">\n<h3 class=\"pi-data-label pi-secondary-font\">Difficulty</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Easy\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Level_Easy_76d062.gif\" width=\"57\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Occurrence</h3>\n<div class=\"pi-data-value pi-font\"><span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Common\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Occurrence_Common_bbcd9e.gif\" width=\"46\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Charm Points</h3>\n<div class=\"pi-data-value pi-font\">15 <span class=\"mw-default-size\" typeof=\"mw:File\"><img alt=\"Charm Icon\" class=\"mw-file-element\" height=\"12\" loading=\"lazy\" src=\"assets/wiki/Charm_Icon_d968ed.gif\" width=\"11\"/></span></div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occurrence\">\n<h3 class=\"pi-data-label pi-secondary-font\">Kills to Unlock</h3>\n<div class=\"pi-data-value pi-font\">500</div>\n</div>\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\"