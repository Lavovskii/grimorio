=\"scene_table canvas\" style=\"padding:32px;\">\n<tbody><tr>\n<td>\n<div class=\"tile\">\n<div class=\"tibiatext caster_name\">Dipthrah</div><div class=\"hp_bar\"></div>\n<div class=\"effect\"></div>\n<div class=\"caster-south\"><img alt=\"latest?cb=20060901022456&amp;path-prefix=en\" class=\"\" loading=\"lazy\" src=\"assets/wiki/Ashmunrah_42fd04.gif\"/></div>\n<div class=\"effect\"></div>\n<div class=\"effect\"></div>\n</div>\n</td>\n</tr>\n</tbody></table></div></div></div>\n<div style=\"clear:left;\"></div>\n</div>\n<div class=\"mobile-hide\" id=\"w-creature-resistance-table\">\n<h3><span class=\"mw-headline\" id=\"w-Damage_Taken_From_Elements\">Damage Taken From Elements</span></h3>\n<div id=\"w-creature-resistance-d\">\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Physical\"><div class=\"creature-resistance-label\">Physical <span typeof=\"mw:File\"><span><img alt=\"Bestiary Physical Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Bestiary_Physical_Icon_Big_83da43.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 0 1px 1px; width:0.0000%; background-color:#ff3333; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; left:calc(5px + 100% * 0.0000); display:inline-block;\">0%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Death\"><div class=\"creature-resistance-label\">Death <span typeof=\"mw:File\"><span><img alt=\"Cursed Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Cursed_Icon_Big_de8a1f.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 0 1px 1px; width:0.0000%; background-color:#ff3333; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; left:calc(5px + 100% * 0.0