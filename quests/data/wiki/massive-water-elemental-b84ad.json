0000%; background-color:#ff3333; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; left:calc(5px + 100% * 0.0000); display:inline-block;\">0%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Fire\"><div class=\"creature-resistance-label\">Fire <span typeof=\"mw:File\"><span><img alt=\"Burning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Burning_Icon_Big_a56686.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 0 1px 1px; width:0.0000%; background-color:#ff3333; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; left:calc(5px + 100% * 0.0000); display:inline-block;\">0%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.2500\" title=\"Energy\"><div class=\"creature-resistance-label\">Energy <span typeof=\"mw:File\"><span><img alt=\"Electrified Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Electrified_Icon_Big_b60abe.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:100.0000%; background-color:#27c429; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 0.0000%); display:inline-block;\">125%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Earth\"><div class=\"creature-resistance-label\">Earth <span typeof=\"mw:File\"><span><img alt=\"Poisoned Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Poisoned_Icon_Big_f04eb1.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 0 1px 1px; width:0.0000%; background-color:#ff3333; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; left:calc(5px + 100% * 0.0000); display:inline-block;\">0%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"0.0000\" title=\"Drown\"><div class=\"creature-resistance-label\">Drown <span typeof=\"mw:File\"><span><img alt=\"Drowning Icon Big\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Drowning_Icon_Big_f65e47.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 0 1px 1px; width:0.0000%; background-color:#ff3333; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; left:calc(5px + 100% * 0.0000); display:inline-block;\">0%</div></div></div>\n<div class=\"creature-resistance-el\" data-value=\"1.0000\" title=\"Healing\"><div class=\"creature-resistance-label\">Healing <span typeof=\"mw:File\"><span><img alt=\"Healing Icon\" class=\"mw-file-element\" height=\"16\" loading=\"lazy\" src=\"assets/wiki/Healing_Icon_be4df6.gif\" width=\"16\"/></span></span></div><div class=\"creature-resistance-bar1\"><div class=\"creature-resistance-bar2\" style=\"border-width:1px 1px 1px 1px; width:80.0000%; background-color:#ffffff; left:0.0000%;\"></div><div class=\"creature-resistance-pct\" style=\"position:absolute; right:calc(5px + 20.0000%); display:inline-block;\">100%</div></div></div>\n</div><div style=\"clear:left;\"></div>\n</div>\n<div id=\"w-creature-location\">\n<h3><span class=\"mw-headline\" id=\"w-Location\">Location</span></h3>\n<p><a href=\"#/wiki/Calassa\">Calassa</a>, <a href=\"#/wiki/Frozen%20Trench\">Frozen Trench</a>, <a href=\"#/wiki/Water%20Elemental%20Dungeon\">Water Elemental Dungeon</a> through the water channels, before <a href=\"#/wiki/Zugurosh\">Zugurosh</a> in <a href=\"#/quest/the-inquisition-quest\">The Inquisition Quest</a>.\n</p>\n</div>\n<div id=\"w-creature-behaviour\">\n<h3><span class=\"mw-headline\" id=\"w-Behaviour\">Behaviour</span></h3>\n<p>\tMassive Water Elementals are as fast as a <a href=\"#/wiki/Level\">Level</a> 100 character.<br/><br/>A massive water elemental attacks in melee range. A massive water elemental never retreats.\n</p>\n</div>\n<div id=\"w-creature-strategy\">\n<h3><span class=\"mw-headline\" id=\"w-Strategy\">Strategy</span></h3>\n<p> <b>All vocations</b>: Remember to bring your <a href=\"#/wiki/Helmet%20of%20the%20Deep\">Helmet of the Deep</a> when hunting these! It blocks 100% of their strongest attack, the water bomb. The heavy weight of the helmet will be easily compensated as it will save you from their most deadly combos.<br/>\n<b>Mages</b> should use Energy-Based Attacks and run.<br/>\n<b><a href=\"#/wiki/Paladin\">Paladins</a></b> should run away from them in most cases, but if you have to fight use a good bow and flash arrows.<br/>\n<b><a href=\"#/wiki/Knight\">Knights</a></b>  should run away from them in most cases, but if you have to fight use spells to kill them fast.\n</p>\n</div>\n<div style=\"clear:left;\"></div>\n<div class=\"history-section\" id=\"w-creature-history\">\n<h3><span class=\"mw-headline\" id=\"w-History\">History</span></h3>\n<ul><li>They used to be stronger before Winter Update 2008.</li>\n<li>Since Summer Update 2009 they drop loot, which makes them more profitable.</li>\n<li>Since 2010 autumn patch they drop normal loot from openable corpse, but it is still possible to fish the corpses to get <a href=\"#/wiki/Giant%20Shimmering%20Pearl\">Giant Shimmering Pearls</a> and other gems.</li>\n<li>As announced on March 04, 2025, the patch added a \"semi-rare\" chance of looting <a href=\"#/wiki/Might%20Ring\">Might Ring</a> from this creature.</li></ul>\n</div>\n<div style=\"clear:both;\"></div>\n<div>\n<h3><span class=\"mw-headline\" id=\"w-Loot\">Loot</span></h3>\n<p><small><i>Drop rates are estimated based on 641 samples <span class=\"loot-stats-link\">(Loot Statistics)</span>.</i></small> <small><i>Colour-coding is applied after 500 samples.</i></small><br/><small><i>Task column indicates items used in delivery tasks.</i></small>\n</p>\n<table class=\"wikitable sortable\" style=\"text-align:center; width:auto;\">\n<tbody><tr>\n<th></th>\n<th>Item</th>\n<th>Task</th>\n<th>Quantity</th>\n<th>Avg</th>\n<th data-sort-type=\"number\">%\n</th></tr>\n<tr>\n<td><span class=\"loot-table-icon\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Gold%20Coin\"><img alt=\"Gold Coin\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Gold_Coin_a5b511.gif\" width=\"32\"/></a></span></span></span></td>\n<td><a href=\"#/wiki/Gold%20Coin\">Gold Coin</a></td>\n<td></td>\n<td>1-100</td>\n<td>50.0</td>\n<td class=\"loot-common\" data-sort-value=\"100.000000\" style=\"text-align:center;\">100%\n</td></tr>\n<tr>\n<td><span class=\"loot-table-icon\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Fish\"><img alt=\"Fish\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Fish_332645.gif\" width=\"32\"/></a></span></span></span></td>\n<td><a href=\"#/wiki/Fish\">Fish</a></td>\n<td></td>\n<td>1-2</td>\n<td>0.60</td>\n<td class=\"loot-common\" data-sort-value=\"39.157566\" style=\"text-align:center;\">39%\n</td></tr>\n<tr>\n<td><span class=\"loot-table-icon\"><span class=\"no-pseudoelements-container\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"#/wiki/Platinum%20Coin\"><img alt=\"Platinum Coin\" class=\"mw-file-element\" height=\"32\" loading=\"lazy\" src=\"assets/wiki/Platinum_Coin_c8a106.gif\" width=\"32\"/></a></span></span></span></td>\n<td><a href=\"#/wiki/Platinum%20Coin\">Platinum Coin</a></td>\n<td></td>\n<td>1-2</td>\n<td>0.41</td>\n<td class=\"loot-common\" data-sort-value=\"27.301092\" style=\"text-align:center;\">27%\n</td></tr>\n<tr>\n<td><span class=\"loot-table-icon\"><span class=\"no-pseudoeleme