[[["duration"],"195eb9cee5a29e0c","30 min (krótka trasa) do 1–2 godzin (długa trasa)"],[["summary"],"cb1ef5934c4a26c7","Alawar ukrył swój skarb w skarbcu pilnowanym przez minotaury i pola magiczne, pod wyspą Senja, na północ od Carlin. Są dwie drogi: krótka, przez zamek Senja, daje 3 {item:White Pearl|White Pearls} i {item:Broadsword}; długa, przez jaskinie Folda, daje wszystkie nagrody, w tym {item:Dark Helmet} i trzy klucze."],[["start","label"],"1790d9eef2753eb6","Tratwa na północ od Carlin"],[["sections",0,"steps",0,"coords",0,"label"],"1790d9eef2753eb6","Tratwa na północ od Carlin"],[["sections",0,"steps",1,"coords",0,"label"],"a1f1165292816068","Wejście do piwnicy Senja Castle"],[["sections",0,"steps",2,"images",0,"caption"],"86d34917722ada01","Dźwignia ukryta pod ogniem"],[["sections",0,"steps",4,"images",0,"caption"],"c0161bed28d06219","Teleport do Alawar's Vault"],[["sections",0,"steps",6,"coords",0,"label"],"abb8697c0705e470","Anderson (tratwa na Senja)"],[["sections",1,"steps",0,"coords",0,"label"],"837f86910ef0fac1","Wejście do jaskiń Folda"],[["sections",1,"steps",7,"coords",0,"label"],"abb8697c0705e470","Anderson (tratwa na Senja)"]]