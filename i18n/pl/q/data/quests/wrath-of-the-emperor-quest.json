[[["duration"],"051381e6c7953ece","około 12 godzin (kilka sesji)"],[["summary"],"850d01087bbb16ec","Pomóż {npc:Zalamon} i lizardom-rebeliantom ze Zao obalić zepsutego cesarza smoków. Infiltrujesz północne Zao, ukryty w skrzyni, reaktywujesz teleporty, zabijasz The Keeper, składasz starożytne berło w Deeper Banuta, wchodzisz do Razachai, najeżdżasz pałac, uwalniasz śpiącego smoka przez jego sen i niszczysz cztery inkarnacje cesarza oraz samego zmutowanego Zalamona. Na końcu dostajesz dużo gold i skarbów, zbroję draken do wyboru, outfit Wayfarer i stały dostęp do Razachai."],[["start","label"],"be95e45087cc6d14","Zalamon, kryjówka w Zao"],[["requirements",0],"1c42cf7dfb253a6f","Konto **Premium**."],[["unlocks",0,"what"],"0896e42382f6f501","Północne Zao (Northern Zao Plantations, Souleater Mountains, Ghastly Dragon Lair)"],[["unlocks",0,"when"],"8f776422ccfb2db4","Misja 1 (Catering the Lion's Den): wchodzisz do Lion's Den ukryty w {item:Marked Crate}."],[["unlocks",1,"when"],"5053f0f912a71b55","Misja 1: pierwsze przybycie przez Lion's Den."],[["unlocks",2,"what"],"e43513fc23b70e18","Niebieski płomień między salą Chartana a Muggy Plains"],[["unlocks",2,"when"],"c431283ac30aad70","Po misji 2 (First Contact), gdy reaktywujesz teleport i zgłosisz się do {npc:Chartan}."],[["unlocks",3,"what"],"ed46b0abaab5bad3","Cztery najgłębsze piętra Deeper Banuta"],[["unlocks",3,"when"],"c5bcb29a746fd56c","Misja 4 (Sacrament of the Snake)."],[["unlocks",4,"when"],"a7ceab94e00a6550","Misja 5 (New in Town)."],[["unlocks",4,"note"],"67402dfb21b0fe5d","Stały dostęp po ukończeniu questa."],[["unlocks",5,"what"],"096dbe2436cab3e8","Inner Sanctum w Razachai"],[["unlocks",5,"when"],"1eb27a645dc61a10","Misja 10 (A Message of Freedom)."],[["unlocks",6,"what"],"d913a0ac03a6f27e","Teleporty między Razachai, Rebel Camp i Inner Sanctum"],[["unlocks",6,"when"],"8782ab06454ffe12","Po ukończeniu questa (misja 12)."],[["sections",0,"steps",0,"coords",0,"label"],"65f8921c8eef1c1c","Steamship z Farmine (Th