[[["summary"],"ff3a9d1117819077","Od czasu do czasu złodzieje napadają na bank w Thais, Carlin, Ab'Dendriel lub Venore i bankier przestaje działać. Znajdź złodzieja ukrytego w pobliżu miasta, zabij go, podnieś {item:Bag With Stolen Gold} i oddaj bankierowi przed Server Save. Dostajesz 10 {item:Platinum Coin|Platinum Coins} i achievement **Honest Finder** (oraz **Goldhunter** po pięciu workach)."],[["start","label"],"3de026a91b0d12f5","Bankier okradzionego miasta (np. Naji, Thais)"],[["sections",0,"steps",1,"title"],"fc590b211cafd681","Potwierdzić miasto"],[["sections",0,"steps",1,"table","head",0],"dcad78cdabcd339f","Miasto"],[["sections",1,"steps",0,"coords",0,"label"],"f8c1404a09720620","Wejście do Ancient Temple"],[["sections",1,"steps",0,"coords",1,"label"],"a1d0c05f87db96d9","Kryjówka Jesse the Wicked (Ancient Temple)"],[["sections",1,"steps",2,"coords",1,"label"],"8e524dcb821db65f","Jaskinia wejściowa do Ghostlands"],[["sections",1,"steps",2,"coords",2,"label"],"7d2261d24b941e90","Kryjówka Robby the Reckless (Ghostlands)"],[["sections",1,"steps",3,"coords",0,"label"],"26fb7ecdeaa90561","Główny budynek Shadowthorn"],[["sections",1,"steps",3,"coords",1,"label"],"e7c2ad8c9059b1e4","Kryjówka Mornenion (Shadowthorn)"]]