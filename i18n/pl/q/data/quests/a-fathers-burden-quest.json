[[["duration"],"2931b125db8ec1bb","4–6 godzin (dużo podróży między miastami)"],[["summary"],"ca04737a0a5df782","{npc:Tereban} z Edron chce podarować specjalne prezenty swojej czwórce dzieci (knightowi, sorcererowi, druidowi i paladynowi), które mają urodziny tego samego dnia. Rzemieślnicy potrzebują ośmiu rzadkich komponentów ukrytych w dungeonach na całym kontynencie. Znajdź je wszystkie i oddaj Terebanowi, żeby dostać 28 000 punktów doświadczenia, 8000 gp i {item:Old Cape}."],[["start","label"],"5d5e58b875baf568","Tereban, tawerna Mirabell (nad depot w Edron)"],[["unlocks",0,"what"],"af17c32eb3926af0","Addon Cape Wayfarer ({wiki:Wayfarer Outfits Quest})"],[["unlocks",0,"when"],"99ce184980ad5bcf","{item:Old Cape}, który dostajesz na końcu, jest itemem wymaganym do tego addonu."],[["sections",0,"steps",1,"table","rows",6,1],"d9518f94d1b24e3e","Tarcza (knight)"],[["sections",0,"steps",1,"table","rows",7,1],"d9518f94d1b24e3e","Tarcza (knight)"],[["sections",1,"steps",0,"coords",1,"label"],"5778e88cff03156c","Edron Wyvern Hill (na północ od Edron)"],[["sections",2,"steps",0,"coords",1,"label"],"4ab2e96cb9a9c55a","Buddel (na południe od Svargrond)"],[["sections",2,"steps",0,"coords",2,"label"],"910811baa60f6270","Buddel w obozach barbarzyńców"],[["sections",2,"steps",2,"coords",0,"label"],"910811baa60f6270","Buddel w obozach barbarzyńców"],[["sections",3,"steps",0,"coords",0,"label"],"f29cab5014d66faa","Statek Dalbrect (Carlin)"],[["sections",3,"steps",1,"images",0,"caption"],"edfffbebe58cef5d","Isle of the Kings: przejście ze statku"],[["sections",4,"steps",0,"coords",0,"label"],"65f8921c8eef1c1c","Steamship z Farmine (Thorgrin)"],[["sections",4,"steps",0,"coords",1,"label"],"93c830500c2caa86","Wyjście z góry na Zao Steppe"],[["sections",4,"steps",0,"coords",2,"label"],"43463a3bd357cc75","Curos (centralny obóz orków)"],[["sections",4,"steps",1,"coords",0,"label"],"55e153f9497acb67","Wejście do Zao Wailing Widow Cave"],[["sections",4,"steps",1,"images",0,"caption"],"dbe