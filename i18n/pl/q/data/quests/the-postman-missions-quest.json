[[["duration"],"dc8735aea083f334","~4 godziny (10 misji; można wykonywać etapami)"],[["summary"],"3dce1b3ed3c2e99e","{npc:Kevin} prowadzi Tibia Postal Service i przyjmuje tylko listonoszy, którzy udowodnią swoją wartość. Wykonujesz 10 misji pocztowych w całej Tibii, awansując od Assistant Postman do Arch Postman. Dostajesz tańsze listy i paczki, zniżki na łodzie, {item:Post Officer's Hat}, {item:Post Horn}, dostęp do królewskich skrzynek pocztowych i achievement **Archpostman**."],[["start","label"],"a1e122684e25205a","Poczty Kevina, między Thais a Kazordoon"],[["requirements",0],"1c42cf7dfb253a6f","Konto **Premium**."],[["unlocks",0,"what"],"3fb8dcadc426676b","Paczki po 10 gp i listy po 5 gp"],[["unlocks",0,"when"],"2dffa7d479f7ae1c","Po osiągnięciu **Assistant Postman** (koniec misji 2)."],[["unlocks",1,"what"],"6a9396b2a22a0b82","Podróże łodzią tańsze o 10 gp"],[["unlocks",1,"when"],"b5d100c2d898e052","Po osiągnięciu **Grand Postman** (koniec misji 6)."],[["unlocks",2,"what"],"dd22c4364f3d2bf8","Królewskie skrzynki pocztowe w niebezpiecznych strefach"],[["unlocks",2,"when"],"61b2020110fe088f","Po osiągnięciu **Arch Postman** (koniec misji 10)."],[["unlocks",3,"what"],"db065a80ef1294b6","Skrót w misji 6 z The Thieves Guild Quest"],[["unlocks",3,"when"],"d92ad4d92b6d9a25","Z rankiem **Arch Postman** i {item:Post Officer's Hat} na głowie dostajesz klucz do misji 6 (Fishnapping) bez łapówek."],[["unlocks",3,"note"],"4ff4b836fc9f6478","Wiki wspomina o zniżce 6k w tym queście."],[["sections",0,"steps",0,"coords",0,"label"],"1f4712e5dbe8999b","Poczta Kevina"],[["sections",6,"steps",0,"table","head",1],"e38ffbd3494c20d9","Miasto / miejsce"],[["sections",6,"steps",0,"table","rows",2,1],"c2c71e5b8be26755","Ab'Dendriel, na południowy zachód od depotu {coord:32672,31700,7}"],[["sections",6,"steps",0,"table","rows",3,1],"e5a8ce66d017ed84","Kazordoon, północny kraniec depotu {coord:32648,31906,8}"],[["sections",6,"steps",0,"table","rows",5,1],"445485d334db05cf","Venore, cave d