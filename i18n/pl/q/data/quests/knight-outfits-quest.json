[[["duration"],"393fc0830a101727","1–2 godziny (jeśli masz już itemy) + 2 h czekania na hełm"],[["summary"],"7ee912f7b3eacf9f","{wiki:Knight Outfits|Knight Outfit} może nosić każdy gracz; ten quest daje oba addony. Miecz kuje {npc:Morgan} w Sabrehaven w zamian za rudę żelaza. Ozdobny hełm przyznaje {npc:Gregor}, przywódca gildii knightów w Thais, gdy udowodnisz swoją wartość czterema zadaniami; hełm kończy {npc:Sam}. Dostajesz też achievement **In Shining Armor**."],[["start","label"],"df65bfa042118176","Gregor, gildia knightów w Thais"],[["requirements",0],"4904e29996182b07","Konto Premium."],[["rewards",0,"text"],"25d9ea2158f5a397","Addon 1 Knight Outfit: miecz"],[["rewards",1,"text"],"6e61228ae4061d08","Addon 2 Knight Outfit: ozdobny hełm"],[["sections",1,"title"],"3cb8385652093cf0","2. Addon z hełmem (Gregor, Thais)"],[["sections",1,"steps",0,"title"],"49ba45b7b9f04b2b","Przyjąć zadanie od Gregora"],[["sections",1,"steps",2,"coords",1,"label"],"67f2a8e008ad40ac","Świątynia Hairycles (schody w dół)"],[["sections",1,"steps",2,"coords",2,"label"],"dc2e47eaaa247526","Schody na piętro -2"],[["sections",1,"steps",2,"coords",3,"label"],"d00116a93f235e4d","Magic Forcefield do Deeper Banuta"],[["sections",1,"steps",4,"coords",0,"label"],"a44e853d46e4f7d9","Charles (statek w Port Hope)"],[["sections",1,"steps",9,"reward"],"fc16bcaa34477454","Addon z hełmem"]]