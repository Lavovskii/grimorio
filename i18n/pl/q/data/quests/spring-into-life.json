:Captain Cookie} w porcie Yalahar zabierze cię do Liberty Bay ({key:liberty bay}) lub do Thais ({key:thais})."],[["sections",2,"steps",4,"map","marks",0,"label"],"a2541bab0a805d51","Sala gier"],[["sections",2,"steps",4,"map","marks",1,"label"],"9034acf1f0165061","Fontanna zachodnia"],[["sections",2,"steps",4,"map","marks",2,"label"],"82afa51e02fedf34","Rampa Arena Quarter"],[["sections",2,"steps",4,"map","marks",3,"label"],"f561141d0d0c128f","Doki"],[["sections",2,"steps",4,"map","marks",4,"label"],"ec8f196b5b099dbb","Budynek Explorer Society"],[["sections",2,"steps",4,"table","head",2],"e45951136f06bb35","Współrzędne"],[["sections",2,"steps",4,"table","rows",0,1],"7cf9eef7e0171a2d","Sala gier (1 piętro niżej)"],[["sections",2,"steps",4,"table","rows",1,1],"9034acf1f0165061","Fontanna zachodnia"],[["sections",2,"steps",4,"table","rows",2,1],"82afa51e02fedf34","Rampa Arena Quarter"],[["sections",2,"steps",4,"table","rows",3,1],"f561141d0d0c128f","Doki"],[["sections",2,"steps",4,"table","rows",4,1],"ec8f196b5b099dbb","Budynek Explorer Society"],[["sections",2,"steps",5,"text"],"15966c48455a97ac","5 gniazd w **Svargrond**: Złap statek do Svargrond w Carlin, Thais lub Venore ({key:hi}, {key:svargrond}, {key:yes}); dopłyniesz do statku {npc:Captain Breezelda}, która też zabiera cię z powrotem."],[["sections",2,"steps",5,"map","marks",0,"label"],"5bad885b7658ff6d","Gildia paladynów"],[["sections",2,"steps",5,"map","marks",1,"label"],"23a41145a1ab190b","Za Mead Hall"],[["sections",2,"steps",5,"map","marks",2,"label"],"301ca06684454c68","Na zachód od Buddela"],[["sections",2,"steps",5,"map","marks",3,"label"],"774b327d34c6107f","Na zachód od statku"],[["sections",2,"steps",5,"table","head",2],"e45951136f06bb35","Współrzędne"],[["sections",2,"steps",5,"table","rows",0,1],"5bad885b7658ff6d","Gildia paladynów"],[["sections",2,"steps",5,"table","rows",1,1],"23a41145a1ab190b","Za Mead Hall"],[["sections",2,"steps",5,"table","rows",2,1],"49d28c78571239bc","Na zachód od {npc:Budde