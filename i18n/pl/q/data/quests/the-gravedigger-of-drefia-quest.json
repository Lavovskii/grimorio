[[["duration"],"86f899f22c18d60e","6–10 godzin (kilka sesji)"],[["summary"],"9965cea977a27bf1","Nekromanta {npc:Omrabas}, ukryty w ruinach {wiki:Drefia|Drefia}, chce wrócić do życia. W trzech tomach zbierasz dla niego części ciała, konsekrujesz pięć ołtarzy w sali w kształcie gwiazdy i odzyskujesz pięć kawałków zwoju z zaklęciem. Na końcu rytuał się nie udaje (zwój był przepisem na rosół!) i wściekły Omrabas daje ci {item:Nail Case}, potrzebny do oswojenia mounta {wiki:Hellgrip|Hellgrip}."],[["start","label"],"683b813d3f66fa21","Loose Stone Pile prowadzący do kryjówki Omrabasa, Drefia"],[["requirements",1],"4904e29996182b07","Konto Premium."],[["unlocks",0,"what"],"3b8afb98336d9880","Mount Hellgrip"],[["unlocks",0,"when"],"4f79a705dab9d9f1","Na końcu questa {npc:Omrabas} daje ci {item:Nail Case}, którym możesz oswoić {creature:Gravedigger}."],[["sections",0,"steps",0,"coords",0,"label"],"b5328759d77b619b","Rope spot do wejścia na górę do Drefia"],[["sections",0,"steps",0,"images",0,"caption"],"79c0e7ce626924d8","Mapa Drefia"],[["sections",0,"steps",1,"coords",1,"label"],"704b2a1a91318f24","Omrabas (sala w kryjówce)"],[["sections",6,"steps",1,"title"],"fdfdb33e627250bc","Zdobyć kość"],[["sections",7,"steps",2,"images",0,"caption"],"f909fd1a5c1906b2","Ołtarz 3: Bloodgong Altar (południowy zachód)"],[["sections",8,"steps",4,"images",0,"caption"],"a0cbd1634b3feafb","Ołtarz 4: Fireglass Altar (północny zachód)"],[["sections",9,"steps",5,"table","rows",2,1],"6e20226fc3ef70b1","Na górze"],[["sections",9,"steps",5,"images",0,"caption"],"4ec815ff994fda77","Ołtarz 5: Shadowthrone (północ)"],[["sections",10,"steps",0,"title"],"90342b5c3d491d58","Przyjąć poszukiwanie zwoju"],[["sections",10,"steps",2,"title"],"9492c372128d428e","Napełnić pierwszą fiolkę"],[["sections",10,"steps",3,"title"],"ee63af1a67c5fbfc","Napełnić drugą fiolkę"],[["sections",10,"steps",3,"coords",1,"label"],"95e508bdcb24df59","Drugie zejście"],[["sections",12,"steps",3,"coords",0,"label"],"215b41a181610df5"