[[["duration"],"d2bfd7e17192596f","≈1–2 godziny podróży (jeśli skorzystasz ze wskazówek od Lai, potrzebuje ona kilku dni, żeby je ujawnić)"],[["summary"],"aaf09a785fb4ef0e","{npc:Lai} w Azzilon Castle opowiada legendę o poszukiwaczu przygód, który ukradł fragment kryształu ze statuy strażnika Merudri i ukrył części jej miniatury w trzech sanktuariach na całym świecie. Znajdź trzy fragmenty — w Nibelor, w Zao i w Kilmaresh — i połącz je z fragmentami kryształu na szczycie skały w Kha'zeel, żeby złożyć {item:Guardian Statue (Quest)}."],[["start","label"],"b6ebe463616b8f2d","Lai, w Azzilon Castle (opcjonalnie)"],[["requirements",0],"1c42cf7dfb253a6f","Konto **Premium**."],[["requirements",5],"abd43b7c8cee6698","Spell {spell:Levitate} (wchodzisz nim na góry i platformy w Inukaya, Kilmaresh i Kha'zeel)."],[["sections",0,"steps",0,"coords",0,"label"],"0f648872ea5ade58","Teleport do Azzilon Castle (Edron)"],[["sections",1,"title"],"110f33dbdc464a31","2. Pierwszy fragment — Inukaya (Nibelor)"],[["sections",1,"steps",0,"coords",0,"label"],"a3a11b5390658a57","Captain Breezelda (port Svargrond)"],[["sections",1,"steps",0,"coords",1,"label"],"1fe5305b86f0c1ab","Iskan (zaprzęg Svargrond → Nibelor)"],[["sections",1,"steps",0,"coords",2,"label"],"5295d0fb1fcb61b7","Wyspa Nibelor"],[["sections",1,"steps",4,"coords",0,"label"],"2196914e8fb399ac","Nilsor (zaprzęg Nibelor → Svargrond)"],[["sections",2,"title"],"30e384d7fb01d77d","3. Drugi fragment — Muggy Plains (Zao)"],[["sections",2,"steps",0,"coords",0,"label"],"4f8885a2b4bd2a8a","Brodrosch (Steamship w Kazordoon)"],[["sections",2,"steps",0,"coords",1,"label"],"2d0887b4f3ec8c9c","Thorgrin (Steamship w Farmine)"],[["sections",2,"steps",0,"coords",2,"label"],"93c830500c2caa86","Wyjście z góry na Zao Steppe"],[["sections",3,"title"],"8ebc2be359d0d815","4. Trzeci fragment — Southern Steppe (Kilmaresh)"],[["sections",3,"steps",0,"coords",2,"label"],"c891f0e8f0f72528","Centrum Issavi"],[["sections",4,"steps",1,"coords",0,"label"],"9f4746