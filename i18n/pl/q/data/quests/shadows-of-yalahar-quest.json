[[["duration"],"02899f2df7e11245","6+ godzin (kilka sesji)"],[["summary"],"1cfe18aff38001f1","Naukowiec {npc:Telas} ze Stonehome (Edron) chce zbudować własnego golema w stylu Yalahari. W ciągu 13 misji zbierasz notatki badawcze na całym kontynencie, kradniesz części z fabryk Yalahar, ładujesz się energią, czytasz książki, po których boli głowa, i przynosisz głowę golema z Fenrock. Na końcu dostajesz 25 000 doświadczenia, {item:Golem Wrench} do oswojenia {wiki:Modified Gnarlhound} (mount), 5 {item:Platinum Coin|Platinum Coins}, achievement **Golem in the Gears** i możesz handlować z Telasem."],[["start","label"],"91f94665d6290baf","Dom Telasa w Stonehome (wejdź po schodach)"],[["unlocks",0,"what"],"6bd943c7807dd493","Mount Modified Gnarlhound"],[["unlocks",0,"when"],"f3c31a869e79df7c","W misji 13: otwórz skrzynię w laboratorium {npc:Telas} i użyj {item:Golem Wrench} na jednym z Modified Gnarlhounds w klatce."],[["unlocks",1,"what"],"094c150ee12bf69a","Wymiany z Telasem (rzadkie metale i kryształy)"],[["unlocks",1,"when"],"9b6e2ea21f2aa980","Po misji 13: powiedz {key:trade} {npc:Telas}, żeby sprzedać mu rzadkie metale i kryształy."],[["sections",0,"steps",0,"table","rows",8,0],"690ca28c1da540c8","**Wszystkie**"],[["sections",1,"steps",0,"images",0,"caption"],"91a93b4189f85e7f","Mapa Stonehome"],[["sections",1,"steps",3,"coords",0,"label"],"895e085625def87a","Scutty w Kazordoon"],[["sections",1,"steps",3,"coords",1,"label"],"4f8885a2b4bd2a8a","Brodrosch (Steamship w Kazordoon)"],[["sections",1,"steps",5,"coords",0,"label"],"1412c8d0a5a5356a","Boveas w Mintwalin"],[["sections",1,"steps",7,"coords",0,"label"],"65d19c48f207131a","Drzwi do Hellgate (Key 3012)"],[["sections",1,"steps",7,"coords",1,"label"],"bd88efd0b29161b2","Elathriel (sprzedaje Key 3012)"],[["sections",1,"steps",7,"coords",2,"label"],"4417b017f491a0d7","Portal wejściowy do Hellgate"],[["sections",1,"steps",9,"coords",0,"label"],"8144c806d0bd056e","Wyjście z Hellgate (powierzchnia, blisko Ab'Dendriel)"],[[