[[["duration"],"232d53603a29d57a","4–6 godzin (misje) + 15–30 min dziennie (zadania)"],[["summary"],"dca63de41c9d6ac2","{npc:Eclesius}, roztargniony sorcerer mieszkający w pobliżu Thais, szuka nowego asystenta. Quest ma dwie części: pięć krótkich zadań, które możesz powtarzać codziennie (zamiatanie, polerowanie, karmienie ryb, tępienie nietoperzy i „zapobieganie apokalipsie”), oraz sześć misji, które zaprowadzą cię do Venore, Ab'Dendriel, Kazordoon i Carlin. W sumie zdobywasz około 5350 gp i 10 650 punktów doświadczenia."],[["start","label"],"7f9fd4dfdff8eec5","Dom Eclesiusa, w pobliżu Thais"],[["sections",0,"steps",0,"title"],"9a7f5bfdb59cd80b","Wejść do domu Eclesiusa"],[["sections",0,"steps",0,"coords",0,"label"],"e46ddc897b3c8f0d","Dom Eclesiusa"],[["sections",6,"steps",2,"coords",0,"label"],"58941eea7ff7fc4e","Captain Bluebear (port w Thais)"],[["sections",6,"steps",2,"coords",1,"label"],"2f367bdba18df337","Captain Fearless (port w Venore)"],[["sections",6,"steps",4,"coords",0,"label"],"2f367bdba18df337","Captain Fearless (port w Venore)"],[["sections",6,"steps",4,"coords",1,"label"],"e46ddc897b3c8f0d","Dom Eclesiusa"],[["sections",7,"steps",4,"title"],"7fa3061ed194bbd4","Wybrać dobry zapach"],[["sections",7,"steps",4,"table","rows",1,1],"4b51b366f2033ae4","Jeden {item:Bread|chleb}"],[["sections",8,"steps",1,"coords",0,"label"],"58941eea7ff7fc4e","Captain Bluebear (port w Thais)"],[["sections",8,"steps",1,"coords",1,"label"],"1ccfc945b6c8b771","Captain Seagull (port Ab'Dendriel)"],[["sections",8,"steps",1,"coords",3,"label"],"2c449bca3489caca","Steamship w Kazordoon (Brodrosch)"],[["sections",8,"steps",6,"table","rows",4,1],"c26940107c8557f0","Fire"],[["sections",8,"steps",7,"table","head",1],"c491a7ada8c67de7","Odpowiedź Grodrika (podsumowanie)"],[["sections",8,"steps",14,"images",2,"caption"],"ee7ada43d621c2e9","Środkowa dźwignia: miesza oba"],[["sections",11,"steps",1,"coords",0,"label"],"58941eea7ff7fc4e","Captain Bluebear (port w Thais)"],[["sections",11,"