[[["summary"],"9372269b19f19d89","Poszukiwacz przygód, który zginął w Helheim, w pobliżu Svargrond, zostawił po sobie kilka przydatnych itemów. Zejdź trzy piętra lochu Helheim, pełnego nieumarłych, i poszukaj jego stosu kości, żeby dostać {item:Berserk Potion}, 2 {item:Platinum Coin|Platinum Coins}, {item:Shard} i 3 {item:Demonic Essence|Demonic Essences}."],[["start","label"],"29b6e6f985005d95","Buddel, na południe od Svargrond"],[["requirements",0],"1c42cf7dfb253a6f","Konto **Premium**."],[["sections",0,"steps",0,"coords",0,"label"],"29b6e6f985005d95","Buddel, na południe od Svargrond"],[["sections",0,"steps",0,"coords",1,"label"],"671cf3359aaf3d71","Buddel w Helheim (przybycie)"],[["sections",1,"steps",0,"title"],"878bd1519b8adf47","Pierwsze piętro"],[["sections",1,"steps",0,"images",0,"caption"],"1000cc8ac8003ece","Trasa w Helheim (2/3)"],[["sections",1,"steps",1,"title"],"51be14594db5b1b5","Drugie piętro"],[["sections",1,"steps",1,"images",0,"caption"],"5ee8cdffc800cb2f","Trasa w Helheim (3/3)"],[["sections",1,"steps",2,"title"],"612de43ce1b84d22","Trzecie piętro i skarb"],[["sections",2,"steps",0,"coords",0,"label"],"709915f2b30a35de","Buddel w Helheim (powrót)"]]