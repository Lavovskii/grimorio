[[["duration"],"0c10cf66ae3adcda","Event od 11 do 15 listopada (nagrody do 30 listopada); 2–6 godzin na zapalenie wszystkich czasz"],[["summary"],"66e5c0708c89be76","Co roku w listopadzie {npc:Lucius} prosi Lightbearers o utrzymywanie przez 96 godzin zapalonych 10 {item:Lightbringer's Basin|świętych czasz} rozsianych po świecie. W Yalahar dostajesz {item:Magical Torch} i używasz jej przy każdej czaszy, mierząc się ze stworzeniami ciemności, które mogą się pojawić. Jeśli serwerowi się uda, są globalne bonusy i sala nagród w Kazordoon z plecakami pełnymi pierścieni, gemów, Midnight Shards i achievementów."],[["start","label"],"f4fcefcee568af2e","Lucius, Magician Quarter w Yalahar"],[["sections",0,"steps",3,"title"],"5af5c7a905db791b","Wyjść z Temple of Light"],[["sections",0,"steps",3,"images",0,"caption"],"34438d5ffd5a85ab","Mapa Temple of Light"],[["sections",1,"steps",0,"coords",1,"label"],"07dd4c003bd76326","Statek Captain Breezelda (Svargrond)"],[["sections",1,"steps",2,"coords",0,"label"],"517009c790ee7de1","The Blind Prophet (wejście)"],[["sections",1,"steps",4,"coords",1,"label"],"3f5de8d538ca4225","Statek Jack Fate w Goroma"],[["sections",1,"steps",4,"coords",2,"label"],"2af82b49ef404fc3","Schody Teleportation Hub w Goroma"],[["sections",1,"steps",4,"coords",3,"label"],"ce9a399a93a2360e","Schody Teleportation Hub w Ramoa"],[["sections",1,"steps",6,"coords",1,"label"],"5795c4efc4d6f3dd","Wejście do głównego dungeonu w Drefia"],[["sections",1,"steps",6,"coords",2,"label"],"b5328759d77b619b","Rope spot do wejścia na górę do Drefia"],[["sections",1,"steps",7,"coords",1,"label"],"65d19c48f207131a","Drzwi do Hellgate (Key 3012)"],[["sections",1,"steps",7,"coords",2,"label"],"4417b017f491a0d7","Portal wejściowy do Hellgate"],[["sections",1,"steps",8,"coords",0,"label"],"8144c806d0bd056e","Wyjście z Hellgate (powierzchnia, blisko Ab'Dendriel)"],[["sections",1,"steps",10,"coords",0,"label"],"84d3150d06629a05","Misa w Magician Quarter"],[["sections",1,"steps",10,"image