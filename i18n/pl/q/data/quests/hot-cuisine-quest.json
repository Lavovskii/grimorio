[[["duration"],"e8fbf0fef281e6c6","Kilka godzin (głównie zbieranie składników); tylko w sierpniu"],[["summary"],"0bd674f31a92a00b","Kucharz {npc:Jean Pierre}, który mieszka na zachód od Blue Djinn Fortress, w pobliżu Ankrahmun, przyjmuje cię na ucznia. Na każde danie przynosisz mu listę składników, a on gotuje je razem z tobą: najpierw 10 dań z kursu, potem „menu” ze zwycięskimi daniami z konkursu z 2010 roku i {item:Zaoan Sauce}. Zatrzymujesz wszystkie dania (ze specjalnymi efektami), dostajesz achievement **Culinary Master** oraz książki {item:Jean Pierre's Cookbook I} i {item:Jean Pierre's Cookbook II}."],[["start","label"],"f27a3094ca90b562","Jean Pierre, na zachód od Blue Djinn Fortress (1 piętro nad ziemią)"],[["sections",0,"steps",0,"title"],"fa622c7118f8eee1","Zrobić mąkę w Thais"],[["sections",0,"steps",2,"table","rows",12,2],"b6bcbd757671d137","Prawie wszystkie miasta (np. Edron, Venore, Darashia, Carlin)"],[["sections",0,"steps",2,"table","rows",22,2],"95449e25772bb2f9","Do zrobienia w Thais"],[["sections",0,"steps",2,"table","rows",26,2],"ae41ead596ebfe53","Prawie wszystkie miasta (np. Darashia)"],[["sections",0,"steps",2,"table","rows",33,2],"ae41ead596ebfe53","Prawie wszystkie miasta (np. Darashia)"],[["sections",0,"steps",2,"table","rows",56,2],"89a97b0ac76abfce","Prawie wszystkie miasta (np. Edron)"],[["sections",1,"title"],"4c82097ebe821696","2. Zostać uczniem Jean Pierre"],[["sections",1,"steps",0,"coords",0,"label"],"042060361a643600","Captain Sinbeard (port Ankrahmun)"],[["sections",2,"steps",0,"table","rows",1,2],"5531143e81d173c8","Zakupy w Venore"],[["sections",2,"steps",0,"table","rows",2,2],"76382a829aaa1cfe","Zakupy w Ankrahmun"],[["sections",2,"steps",0,"table","rows",3,2],"76382a829aaa1cfe","Zakupy w Ankrahmun"],[["sections",2,"steps",0,"table","rows",4,2],"8ae296bb9461e509","Zrób w Thais (pszenica + Millstone)"],[["sections",2,"steps",1,"table","rows",0,2],"5531143e81d173c8","Zakupy w Venore"],[["sections",2,"steps",1,"table","rows",1,2]