[[["summary"],"5534ea9ec7c5d8ce","At the bottom of Edron's Hero Cave, guarded by {creature:Hero|Heroes} and a {creature:Dark Apprentice}, there are two chests with a {item:Wedding Ring} and a {item:Dragon Necklace}. Follow the route through the cave, defeat the Heroes and open the chests."],[["start","label"],"d411d1ea289bb3da","Hero Cave entrance, Edron"],[["requirements",1],"15194a190b812dcb","No minimum level (70+ recommended)."],[["sections",0,"steps",0,"title"],"6a0bbd81aaa5a92d","Enter the Hero Cave"],[["sections",0,"steps",0,"coords",0,"label"],"47a8e33a26c57af6","Hero Cave entrance"],[["sections",0,"steps",0,"coords",1,"label"],"5d8dfaf9b1f7e965","Edron harbour (Captain Seahorse)"],[["sections",1,"steps",1,"coords",0,"label"],"1dd0e91b4b1ce9cb","Hero Cave entrance/exit"],[["sections",1,"steps",1,"coords",1,"label"],"5d8dfaf9b1f7e965","Edron harbour (Captain Seahorse)"]]