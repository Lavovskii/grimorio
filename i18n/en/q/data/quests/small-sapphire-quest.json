[[["duration"],"0d8f0d452c58cc75","5–10 minutes (from Drefia)"],[["summary"],"c1cbae2b40e19bdb","On a small island in {wiki:Drefia} there is a chest with a pirate captain's savings. Cross Drefia, walk to the island and open the chest to receive a {item:Small Sapphire}, 50 gp and two books."],[["requirements",1],"e5429258e91254fe","No minimum level (50 recommended)."],[["items_needed",0,"note"],"1f1c953a11af848c","or equivalent"],[["sections",0,"steps",0,"coords",1,"label"],"9ff20d6be7df862d","Petros (Darashia port)"],[["sections",0,"steps",0,"coords",2,"label"],"fa6ab3890fcf9d8f","Darashia carpet (Chemar)"],[["sections",0,"steps",0,"coords",3,"label"],"b5328759d77b619b","Rope spot to climb up to Drefia"],[["sections",1,"steps",1,"title"],"ee4493e7b469fb41","Open the chest"]]