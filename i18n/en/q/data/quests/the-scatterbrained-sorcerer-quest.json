[[["duration"],"232d53603a29d57a","4–6 hours (missions) + 15–30 min per day (chores)"],[["summary"],"dca63de41c9d6ac2","{npc:Eclesius}, an absent-minded sorcerer who lives near Thais, is looking for a new assistant. The quest has two parts: five short chores you can repeat every day (sweeping, polishing, feeding the fish, exterminating bats and \"preventing the apocalypse\") and six missions that take you to Venore, Ab'Dendriel, Kazordoon and Carlin. In total you earn about 5350 gp and 10650 experience points."],[["start","label"],"7f9fd4dfdff8eec5","Eclesius' house, near Thais"],[["requirements",1],"8a269df6aeed7802","Premium not required."],[["sections",6,"steps",0,"title"],"b9b080cd270da0ed","Accept the mission"],[["sections",6,"steps",2,"coords",0,"label"],"58941eea7ff7fc4e","Captain Bluebear (Thais harbour)"],[["sections",6,"steps",2,"coords",1,"label"],"2f367bdba18df337","Captain Fearless (Venore harbour)"],[["sections",6,"steps",4,"coords",0,"label"],"2f367bdba18df337","Captain Fearless (Venore harbour)"],[["sections",7,"steps",0,"title"],"b9b080cd270da0ed","Accept the mission"],[["sections",8,"steps",0,"title"],"b9b080cd270da0ed","Accept the mission"],[["sections",8,"steps",1,"coords",0,"label"],"58941eea7ff7fc4e","Captain Bluebear (Thais harbour)"],[["sections",8,"steps",1,"coords",1,"label"],"1ccfc945b6c8b771","Captain Seagull (Ab'Dendriel port)"],[["sections",8,"steps",1,"coords",3,"label"],"2c449bca3489caca","Kazordoon steamship (Brodrosch)"],[["sections",8,"steps",1,"images",2,"caption"],"6668838c56566204","Kazordoon entrance"],[["sections",8,"steps",1,"images",3,"caption"],"1321d03757516f93","On-foot route to Kazordoon"],[["sections",9,"steps",0,"title"],"b9b080cd270da0ed","Accept the mission"],[["sections",10,"steps",0,"title"],"b9b080cd270da0ed","Accept the mission"],[["sections",11,"steps",0,"title"],"b9b080cd270da0ed","Accept the mission"],[["sections",11,"steps",1,"coords",0,"label"],"58941eea7ff7fc4e","Captain Bluebear (Thais harbour)"],[["sectio