[[["duration"],"9d2e5b112c81e81d","4–8 hours (7 missions with travelling all over Tibia)"],[["summary"],"26bf6a25f416e045","The secret services of Thais (TBI), Venore (AVIN) and Carlin (CGB) want to uncover all the secrets of Tibia. You choose **one** of the three agencies and carry out seven espionage and sabotage missions around the world. The last mission is the same for everyone: killing the {creature:Mad Technomancer} in Kazordoon. At the end you receive a {item:Mysterious Package} containing a different multi-purpose tool for each agency."],[["start","label"],"e1639a1dc1fb0869","Chester Kahs (TBI, Thais) — or Uncle (AVIN, Venore) / Emma (CGB, Carlin)"],[["sections",0,"steps",2,"coords",1,"label"],"4de1e6d2c36e3eca","Captain Fearless (Venore boat)"],[["sections",0,"steps",2,"coords",3,"label"],"a44e853d46e4f7d9","Charles (Port Hope boat)"],[["sections",0,"steps",2,"coords",4,"label"],"f8a8637e3e188d78","Captain Seahorse (Edron boat)"],[["sections",0,"steps",2,"coords",5,"label"],"4522bd6c0fb6910a","Captain Breezelda (Svargrond boat)"],[["sections",0,"steps",2,"coords",6,"label"],"4aa3fed24e7636e4","Captain Seagull (Ab'Dendriel boat)"],[["sections",0,"steps",2,"coords",7,"label"],"bc77e54862f3ee14","Edron magic carpet"],[["sections",0,"steps",2,"coords",8,"label"],"b9d0b28e5e372d72","Svargrond flying carpet"],[["sections",0,"steps",2,"coords",9,"label"],"ee8d7c23d71d0453","Kazordoon flying carpet"],[["sections",2,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",2,"steps",1,"coords",1,"label"],"653c98746d23b086","Dead tree with Key 5010"],[["sections",2,"steps",1,"coords",2,"label"],"37164c19d9e39fb1","Another dead tree with Key 5010"],[["sections",3,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",4,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",4,"steps",1,"coords",0,"label"],"65d19c48f207131a","Hellgate door (Key 3012)"],[["sections",4,"steps",1,"coords",2,"label"],"4417b017f491a0d7",