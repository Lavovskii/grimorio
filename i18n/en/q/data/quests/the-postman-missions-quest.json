[[["duration"],"dc8735aea083f334","~4 hours (10 missions; can be done in stages)"],[["summary"],"3dce1b3ed3c2e99e","{npc:Kevin} runs the Tibia Postal Service and only accepts postmen who prove their worth. You do 10 mail missions all over Tibia, rising from Assistant Postman to Arch Postman. You get cheaper letters and parcels, boat discounts, the {item:Post Officer's Hat}, the {item:Post Horn}, access to the royal mailboxes and the achievement **Archpostman**."],[["start","label"],"a1e122684e25205a","Kevin's post offices, between Thais and Kazordoon"],[["requirements",1],"4ccaacaf0b29712b","No minimum level (25+ recommended)."],[["unlocks",0,"when"],"2dffa7d479f7ae1c","When you reach **Assistant Postman** (end of mission 2)."],[["unlocks",1,"what"],"6a9396b2a22a0b82","Boat trips 10 gp cheaper"],[["unlocks",1,"when"],"b5d100c2d898e052","When you reach **Grand Postman** (end of mission 6)."],[["unlocks",2,"what"],"dd22c4364f3d2bf8","Royal mailboxes in dangerous areas"],[["unlocks",2,"when"],"61b2020110fe088f","When you reach **Arch Postman** (end of mission 10)."],[["unlocks",3,"what"],"db065a80ef1294b6","Shortcut in mission 6 of The Thieves Guild Quest"],[["unlocks",3,"when"],"d92ad4d92b6d9a25","With the **Arch Postman** rank and the {item:Post Officer's Hat} on your head, you receive the key for mission 6 (Fishnapping) without bribes."],[["unlocks",3,"note"],"4ff4b836fc9f6478","The wiki mentions a 6k discount on that quest."],[["sections",1,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",3,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",4,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",5,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",6,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",7,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",8,"steps",0,"title"],"8cfac6a83978ffa8","Ask for the mission"],[["sections",8,"s