[[["duration"],"02899f2df7e11245","6+ hours (several sessions)"],[["summary"],"1cfe18aff38001f1","The scientist {npc:Telas}, in Stonehome (Edron), wants to build his own golem in the style of the Yalahari. Over 13 missions you collect research notes all over the continent, steal parts from the Yalahar factories, charge yourself with energy, read books that give you headaches and fetch a golem head from Fenrock. At the end you get 25,000 experience, a {item:Golem Wrench} to tame a {wiki:Modified Gnarlhound} (mount), 5 {item:Platinum Coin|Platinum Coins}, the achievement **Golem in the Gears** and you can trade with Telas."],[["start","label"],"91f94665d6290baf","Telas's house in Stonehome (go up the stairs)"],[["unlocks",0,"when"],"f3c31a869e79df7c","In mission 13: open the box in {npc:Telas}'s laboratory and use the {item:Golem Wrench} on one of the Modified Gnarlhounds in the cage."],[["unlocks",1,"what"],"094c150ee12bf69a","Trades with Telas (rare metals and crystals)"],[["unlocks",1,"when"],"9b6e2ea21f2aa980","After mission 13: say {key:trade} to {npc:Telas} to sell him rare metals and crystals."],[["sections",0,"steps",0,"table","head",0],"12c0f313c3296093","Mission"],[["sections",1,"steps",0,"coords",0,"label"],"b9ac981275a4ad20","Captain Seahorse, Edron harbour"],[["sections",1,"steps",0,"images",0,"caption"],"91a93b4189f85e7f","Map of Stonehome"],[["sections",1,"steps",3,"coords",1,"label"],"4f8885a2b4bd2a8a","Brodrosch (Kazordoon Steamship)"],[["sections",1,"steps",4,"coords",0,"label"],"b7ef1bc9191044b9","Ancient Temple (start of the route)"],[["sections",1,"steps",6,"title"],"3c6d0fe0d15318fc","Leave Mintwallin"],[["sections",1,"steps",7,"coords",0,"label"],"65d19c48f207131a","Hellgate door (Key 3012)"],[["sections",1,"steps",7,"coords",2,"label"],"4417b017f491a0d7","Hellgate entrance portal"],[["sections",1,"steps",9,"coords",0,"label"],"8144c806d0bd056e","Hellgate exit (surface, near Ab'Dendriel)"],[["sections",2,"steps",0,"title"],"8cfac6a83978ffa8","As