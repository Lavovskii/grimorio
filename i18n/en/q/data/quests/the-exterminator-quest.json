[[["summary"],"555df842570f6a30","Also known as the Carlin Gems Quest. {npc:Padreia}, of the Carlin druid guild, had a vision: a plague is going to come out of the city sewers, spread by slimes. She gives you a vial of poison to pour into the water the slimes come from. If you do, you receive four small gems."],[["start","label"],"825854ae5f309fba","Padreia, druid guild in Carlin"],[["requirements",0],"359466260b26b346","No minimum level (20+ recommended)."],[["requirements",1],"8a269df6aeed7802","Premium not required."],[["sections",0,"steps",0,"coords",0,"label"],"2eca4da06f2d9ef4","Padreia (druids' guild)"],[["sections",1,"steps",0,"title"],"1b5b0ed329438885","Enter the sewers"],[["sections",1,"steps",0,"coords",0,"label"],"04546fae38d2bbb0","Carlin sewers entrance"],[["sections",1,"steps",0,"images",0,"caption"],"04546fae38d2bbb0","Carlin sewers entrance"],[["sections",1,"steps",3,"title"],"ffcff6107c9bf09e","Leave the sewers"],[["sections",1,"steps",3,"coords",0,"label"],"bb121ea545662d63","Sewer entrance/exit"],[["sections",1,"steps",3,"images",0,"caption"],"6cc7a3c2301675b0","Carlin sewers map"]]