[[["duration"],"99abc2d4cfeaa32c","Evento de 1 semana (del 16 al 23 de abril, aproximadamente); la caza de nidos lleva 1–3 horas"],[["summary"],"790fffecaf26c314","El evento de primavera de Tibia (el antiguo evento de Pascua). Durante una semana aparecen nidos de dragón en los Dragon Lairs de los que salen {creature:Dragon Hatchling|Dragon Hatchlings} (que dan un 25% más de experiencia), los conejos sueltan {item:Coloured Egg|Coloured Eggs} y hay {item:Hidden Nest|Hidden Nests} escondidos por las ciudades. Encuéntralos para conseguir {item:Surprise Nest|Surprise Nests} con dulces, chocolates, huevos y {item:Surprise Bag (Blue)|Blue Surprise Bags}."],[["legend_pt"],"ae0d90d970952dbf","Varios aventureros han informado de actividad inusual en casi todas las guaridas de dragones conocidas. Se han visto muchos huevos de dragón en sus grutas y es solo cuestión de tiempo que la próxima generación de estas desagradables criaturas salga del cascarón..."],[["start","label"],"5cb6da2e149321a2","Ejemplo: nido en el parque de Thais"],[["requirements",0],"b56d075592b306b1","Sin nivel mínimo (recomendado 8)."],[["requirements",1],"da43154306549f9d","Parte del evento es accesible para Free Account; algunas ciudades con nidos son solo para Premium."],[["requirements",2],"383bbed89726f2e4","Solo está activo durante el evento de primavera (del 16 al 23 de abril aproximadamente)."],[["items_needed",0,"note"],"683de66cc43ca3de","o herramienta similar, para cortar {item:Jungle Grass} en 3 de los 5 nidos de Ab'Dendriel"],[["rewards",0,"text"],"eaee7f964b1c0c94","Los {creature:Dragon Hatchling|Dragon Hatchlings} dan **un 25% más de experiencia** durante el evento"],[["rewards",5,"text"],"6f5ebc1c18fe6026","Posiblemente otros items de los {item:Surprise Nest|Surprise Nests}"],[["tips",0],"ea3a4e92f8f6f0c8","Cada ciudad tiene 5 nidos escondidos. Usa las tablas de abajo y haz clic en las coordenadas para abrir el mapa: muchos nidos están en torres o pisos superiores (z menor que 7)."],[["tips",1],"df2b93263b1f7306","Los nidos de dragón de los Dragon Lairs no vuelven a aparecer hasta el próximo {wiki:Server Save}."],[["sections",0,"title"],"3094c8760c438018","1. Qué cambia durante el evento"],[["sections",0,"steps",0,"text"],"8cb356342758c6ac","El Spring into Life sustituyó al antiguo evento de Pascua e incluye todo lo que tenía ese evento: durante el evento, los {creature:Rabbit|Rabbits} sueltan {item:Coloured Egg|Coloured Eggs}, que también puedes comprar a algunos {wiki:Food Shopkeeper NPCs|vendedores de comida}."],[["sections",0,"steps",1,"title"],"e068f3710d6140ed","Nidos de dragón"],[["sections",0,"steps",1,"text"],"1a239469c356f263","En muchos {wiki:Dragon Lairs} por todo Tibia aparecen nidos de dragón de los que, con el tiempo, salen {creature:Dragon Hatchling|Dragon Hatchlings}. Durante el evento los Dragon Hatchlings dan **un 25% más de experiencia**. Los nidos no vuelven a aparecer hasta el próximo Server Save."],[["sections",0,"steps",1,"warning"],"31a0a071cfcc53f9","En los Dragon Lairs encuentras varios tipos de {wiki:Dragons|dragones}: no entres si no tienes el nivel para ellos."],[["sections",0,"steps",2,"title"],"84f9d5b971cd3243","Caza de nidos"],[["sections",0,"steps",2,"text"],"aaa492a905dfcd31","Hay {item:Hidden Nest|Hidden Nests} repartidos por las ciudades de Tibia. Encuéntralos y úsalos para conseguir {item:Surprise Nest|Surprise Nests}, que luego usas para recibir recompensas variadas (dulces, {item:Bar of Chocolate|chocolates}, huevos, {item:Surprise Bag (Blue)|Blue Surprise Bags} y posiblemente más). Las siguientes secciones tienen las 5 ubicaciones de cada ciudad."],[["sections",0,"steps",3,"title"],"bd428401593565ed","Viajar entre ciudades"],[["sections",0,"steps",3,"text"],"c5a7f7cccb056b5e","Para ir de una ciudad a otra, usa los barcos: en el puerto, habla con el capitán y di {key:hi}, el nombre de la ciudad (por ejemplo {key:carlin}) y {key:yes}. Para volver, toma el barco de regreso en el puerto de la ciudad donde estés. Algunas ciudades solo son accesibles con cuenta Premium. Los pasos de Cormaya, Fibula, Yalahar y Svargrond explican cómo llegar allí."],[["sections",1,"title"],"344c4d36b371de12","2. Nidos escondidos: ciudades del continente principal"],[["sections",1,"steps",0,"text"],"08c5a0f7756c6d4f","Los 5 nidos de **Thais**:"],[["sections",1,"steps",0,"map","marks",0,"label"],"ac759f01236276e3","Torre de la puerta norte"],[["sections",1,"steps",0,"map","marks",3,"label"],"8ef5a1080ba0432e","Torre sureste"],[["sections",1,"steps",0,"map","marks",4,"label"],"b816c14dab12eae3","Guild de los sorcerers (por fuera)"],[["sections",1,"steps",0,"table","rows",0,1],"71150388b2844b20","Torre de la puerta norte (3 pisos arriba)"],[["sections",1,"steps",0,"table","rows",3,1],"b21d11d8c543e64a","Torre sureste (2 pisos arriba)"],[["sections",1,"steps",0,"table","rows",4,1],"b816c14dab12eae3","Guild de los sorcerers (por fuera)"],[["sections",1,"steps",1,"text"],"b57500cd13f7998f","Los 5 nidos de **Carlin**:"],[["sections",1,"steps",1,"map","marks",0,"label"],"5f58f7f7a3854343","Tablero de ajedrez"],[["sections",1,"steps",1,"map","marks",1,"label"],"07cdbedabec9184c","Guild de los druids"],[["sections",1,"steps",1,"map","marks",2,"label"],"70d61a878f77720f","Torre del castillo"],[["sections",1,"steps",1,"table","rows",0,1],"f0760d03330c9805","Tablero de ajedrez de Carlin"],[["sections",1,"steps",1,"table","rows",1,1],"684ea715d30dc3cf","Guild de los druids (1 piso arriba)"],[["sections",1,"steps",1,"table","rows",2,1],"54d59416d1467fe2","Torre del castillo (arriba)"],[["sections",1,"steps",2,"text"],"161b10ccdb6f691c","Los 5 nidos de **Ab'Dendriel**. Necesitas una {item:Machete} (o herramienta similar) para cortar {item:Jungle Grass} en el camino hacia 3 de ellos."],[["sections",1,"steps",2,"map","marks",1,"label"],"f91ec574bb9846bc","Jardín"],[["sections",1,"steps",2,"map","marks",2,"label"],"3b17cdd329284677","Pantano"],[["sections",1,"steps",2,"map","marks",3,"label"],"4cda3eba808096ca","Portal de la ciudadanía"],[["sections",1,"steps",2,"map","marks",4,"label"],"93d2936881364ad6","Tienda de fruta"],[["sections",1,"steps",2,"table","rows",1,1],"f91ec574bb9846bc","Jardín"],[["sections",1,"steps",2,"table","rows",2,1],"3b17cdd329284677","Pantano"],[["sections",1,"steps",2,"table","rows",3,1],"4cda3eba808096ca","Portal de la ciudadanía"],[["sections",1,"steps",2,"table","rows",4,1],"93d2936881364ad6","Tienda de fruta"],[["sections",1,"steps",3,"text"],"85d0315bf0ac10cd","Los 5 nidos de **Kazordoon**:"],[["sections",1,"steps",3,"map","marks",0,"label"],"f4ed4b799e323dd9","Vagonetas de la puerta principal"],[["sections",1,"steps",3,"map","marks",1,"label"],"8649d78d5e542935","Cocina real"],[["sections",1,"steps",3,"map","marks",2,"label"],"1d41e17588e41ce9","Biblioteca de los Halls of Sorcery"],[["sections",1,"steps",3,"map","marks",3,"label"],"67a016e47782c10a","Granjas"],[["sections",1,"steps",3,"map","marks",4,"label"],"8cc03b06e162b2f8","La forja"],[["sections",1,"steps",3,"table","rows",0,1],"f4ed4b799e323dd9","Vagonetas de la puerta principal"],[["sections",1,"steps",3,"table","rows",1,1],"8649d78d5e542935","Cocina real"],[["sections",1,"steps",3,"table","rows",2,1],"1d41e17588e41ce9","Biblioteca de los Halls of Sorcery"],[["sections",1,"steps",3,"table","rows",3,1],"67a016e47782c10a","Granjas"],[["sections",1,"steps",3,"table","rows",4,1],"8cc03b06e162b2f8","La forja"],[["sections",1,"steps",4,"text"],"97922d533defc425","Los 5 nidos de **Venore**:"],[["sections",1,"steps",4,"map","marks",0,"label"],"b8751848ad3c6dda","Barco naufragado"],[["sections",1,"steps",4,"map","marks",1,"label"],"93d2936881364ad6","Tienda de fruta"],[["sections",1,"steps",4,"map","marks",3,"label"],"c6904d3d65d4ad6b","Arena de lucha"],[["sections",1,"steps",4,"map","marks",4,"label"],"01ccf29c9c520a94","Tienda de armaduras"],[["sections",1,"steps",4,"table","rows",0,1],"b8751848ad3c6dda","Barco naufragado"],[["sections",1,"steps",4,"table","rows",1,1],"93d2936881364ad6","Tienda de fruta"],[["sections",1,"steps",4,"table","rows",3,1],"0111cc71b31cacab","Arena de lucha (wrestling arena, subterránea)"],[["sections",1,"steps",4,"table","rows",4,1],"808e0a7c44b62b30","Tienda de armaduras (2 pisos arriba)"],[["sections",1,"steps",5,"text"],"9ef7d6ca91b988ee","Los 5 nidos de **Edron**:"],[["sections",1,"steps",5,"map","marks",2,"label"],"40d8d3db0b882379","Sur"],[["sections",1,"steps",5,"map","marks",3,"label"],"807ff8f5849c439b","Casa de Telas"],[["sections",1,"steps",5,"table","rows",2,1],"67e57e8edfdc5b98","Sur de la ciudad"],[["sections",1,"steps",5,"table","rows",3,1],"6731714ac913ad1e","Casa de Telas (1 piso arriba)"],[["sections",1,"steps",6,"text"],"e2a4715b1d1acdcd","Los 5 nidos de **Cormaya**: Cormaya es una isla junto a Edron: en el barco al **norte** de Edron habla con {npc:Captain Seahorse} ({key:hi}, {key:cormaya}, {key:yes}). Desembarcas en el puerto norte de Cormaya, junto a {npc:Pemaret}, que te lleva de vuelta a Edron ({key:hi}, {key:edron}, {key:yes})."],[["sections",1,"steps",6,"map","marks",0,"label"],"fc80187fa85d085d","Al norte de Cormaya Flats"],[["sections",1,"steps",6,"map","marks",1,"label"],"c5be95af97f08b39","Junto a la laguna"],[["sections",1,"steps",6,"map","marks",2,"label"],"d2ef7db4605ccf38","Oeste de las minas, debajo de un árbol"],[["sections",1,"steps",6,"map","marks",3,"label"],"373ac2b05419cff2","Este de las minas"],[["sections",1,"steps",6,"map","marks",4,"label"],"207f58142c97f65c","Debajo de un árbol"],[["sections",1,"steps",6,"table","rows",0,1],"fc80187fa85d085d","Al norte de Cormaya Flats"],[["sections",1,"steps",6,"table","rows",1,1],"5537cdc73009553d","Junto a la laguna (swimming hole)"],[["sections",1,"steps",6,"table","rows",2,1],"ecf91e68de99265a","Oeste de las minas de los enanos, debajo de un árbol"],[["sections",1,"steps",6,"table","rows",3,1],"bd5a2d8c682f9594","Este de las minas de los enanos"],[["sections",1,"steps",6,"table","rows",4,1],"207f58142c97f65c","Debajo de un árbol"],[["sections",1,"steps",7,"text"],"f46fda523176df6a","Los 5 nidos de **Fibula**: Fibula está al sur de Thais: se llega a pie por el túnel que empieza al sur de Thais ({coord:32261,32385,7}) y se vuelve por el mismo túnel."],[["sections",1,"steps",7,"map","marks",1,"label"],"030929feecc64292","Playa oeste"],[["sections",1,"steps",7,"map","marks",2,"label"],"241281c603eeced0","Este del Clanhall de Fibula"],[["sections",1,"steps",7,"map","marks",3,"label"],"0665c81bec8ff90f","Playa este"],[["sections",1,"steps",7,"map","marks",4,"label"],"47606240157c271a","Norte del bar de la aldea"],[["sections",1,"steps",7,"table","rows",1,1],"030929feecc64292","Playa oeste"],[["sections",1,"steps",7,"table","rows",2,1],"7ad2344272ca1d28","Al este del Fibula Clanhall"],[["sections",1,"steps",7,"table","rows",3,1],"0665c81bec8ff90f","Playa este"],[["sections",1,"steps",7,"table","rows",4,1],"0ec522554dd2d08d","Al norte del Fibula Village Bar"],[["sections",2,"title"],"dcf1bdc0fa4451ce","3. Nidos escondidos: ciudades del sur y del norte"],[["sections",2,"steps",0,"text"],"d67ef8878f3b3655","Los 5 nidos de **Ankrahmun** (casi todos en pisos superiores):"],[["sections",2,"steps",0,"map","marks",0,"label"],"579f26038055eebd","Torre suroeste"],[["sections",2,"steps",0,"map","marks",2,"label"],"e3be0211bab74cb5","Tienda de mobiliario"],[["sections",2,"steps",0,"map","marks",4,"label"],"667f1a7f82a8ed77","Guild de paladins/knights"],[["sections",2,"steps",0,"table","rows",0,1],"579f26038055eebd","Torre suroeste"],[["sections",2,"steps",0,"table","rows",2,1],"e3be0211bab74cb5","Tienda de mobiliario"],[["sections",2,"steps",0,"table","rows",4,1],"9fda6c23c4b5ab9f","Guild de paladins/knights, encima de los offline trainers"],[["sections",2,"steps",1,"text"],"46364f47472626d3","Los 5 nidos de **Darashia**:"],[["sections",2,"steps",1,"map","marks",1,"label"],"4c3a430e0d9cf45e","Tiendas"],[["sections",2,"steps",1,"map","marks",2,"label"],"09ae9b2efc56697e","Palacio"],[["sections",2,"steps",1,"table","rows",0,1],"56952a65ef59c489","Templo (arriba)"],[["sections",2,"steps",1,"table","rows",1,1],"4c3a430e0d9cf45e","Tiendas"],[["sections",2,"steps",1,"table","rows",2,1],"09ae9b2efc56697e","Palacio"],[["sections",2,"steps",2,"text"],"6bf823a73e30cd27","Los 5 nidos de **Port Hope**:"],[["sections",2,"steps",2,"map","marks",0,"label"],"4aa21491ea920673","Pequeña isla al oeste"],[["sections",2,"steps",2,"map","marks",1,"label"],"6acb37ec1d21b546","Mirador noroeste"],[["sections",2,"steps",2,"map","marks",2,"label"],"f4f37b7ef7fe29c0","Isla del medio"],[["sections",2,"steps",2,"map","marks",3,"label"],"003bc845f9e87d1b","Orilla del río"],[["sections",2,"steps",2,"map","marks",4,"label"],"7c7caccf3c3f6ecf","Isla suroeste"],[["sections",2,"steps",2,"table","rows",0,1],"4aa21491ea920673","Pequeña isla al oeste"],[["sections",2,"steps",2,"table","rows",1,1],"0e80f9a17f3c9443","Mirador noroeste (3 pisos arriba)"],[["sections",2,"steps",2,"table","rows",2,1],"f4f37b7ef7fe29c0","Isla del medio"],[["sections",2,"steps",2,"table","rows",3,1],"003bc845f9e87d1b","Orilla del río"],[["sections",2,"steps",2,"table","rows",4,1],"7c7caccf3c3f6ecf","Isla suroeste"],[["sections",2,"steps",3,"text"],"3103114f144824ed","Los 5 nidos de **Liberty Bay**:"],[["sections",2,"steps",3,"map","marks",0,"label"],"82351ee4a120e736","Almacén"],[["sections",2,"steps",3,"map","marks",1,"label"],"11d5bf8d0d28d7d9","Faro"],[["sections",2,"steps",3,"map","marks",2,"label"],"030598d77111b0b7","Cerca de la montaña de la fortaleza"],[["sections",2,"steps",3,"map","marks",3,"label"],"d6a1284f8927ecd3","Costa sur"],[["sections",2,"steps",3,"map","marks",4,"label"],"7d8f5d667b0f77fc","Detrás del castillo de Eleonore"],[["sections",2,"steps",3,"table","rows",0,1],"662316b4c9b7d2c0","Almacén (storage shed)"],[["sections",2,"steps",3,"table","rows",1,1],"11d5bf8d0d28d7d9","Faro"],[["sections",2,"steps",3,"table","rows",2,1],"030598d77111b0b7","Cerca de la montaña de la fortaleza"],[["sections",2,"steps",3,"table","rows",3,1],"d6a1284f8927ecd3","Costa sur"],[["sections",2,"steps",3,"table","rows",4,1],"7d8f5d667b0f77fc","Detrás del castillo de Eleonore"],[["sections",2,"steps",4,"text"],"ea2c6dec436e2302","Los 5 nidos de **Yalahar**: Se llega en barco: {npc:Captain Max}, en Liberty Bay, te lleva si tienes el rank Novice de la {wiki:Tibian Explorer Society|Explorer Society}. Para volver, {npc:Captain Cookie}, en el puerto de Yalahar, te lleva a Liberty Bay ({key:liberty bay}) o a Thais ({key:thais})."],[["sections",2,"steps",4,"map","marks",0,"label"],"a2541bab0a805d51","Sala de juegos"],[["sections",2,"steps",4,"map","marks",1,"label"],"9034acf1f0165061","Fuente oeste"],[["sections",2,"steps",4,"map","marks",2,"label"],"82afa51e02fedf34","Rampa del Arena Quarter"],[["sections",2,"steps",4,"map","marks",3,"label"],"f561141d0d0c128f","Muelles"],[["sections",2,"steps",4,"map","marks",4,"label"],"ec8f196b5b099dbb","Edificio de la Explorer Society"],[["sections",2,"steps",4,"table","rows",0,1],"7cf9eef7e0171a2d","Sala de juegos (1 piso abajo)"],[["sections",2,"steps",4,"table","rows",1,1],"9034acf1f0165061","Fuente oeste"],[["sections",2,"steps",4,"table","rows",2,1],"82afa51e02fedf34","Rampa del Arena Quarter"],[["sections",2,"steps",4,"table","rows",3,1],"f561141d0d0c128f","Muelles"],[["sections",2,"steps",4,"table","rows",4,1],"ec8f196b5b099dbb","Edificio de la Explorer Society"],[["sections",2,"steps",5,"text"],"15966c48455a97ac","Los 5 nidos de **Svargrond**: Toma el barco a Svargrond en Carlin, Thais o Venore ({key:hi}, {key:svargrond}, {key:yes}); llegas al barco de {npc:Captain Breezelda}, que también te lleva de vuelta."],[["sections",2,"steps",5,"map","marks",0,"label"],"5bad885b7658ff6d","Guild de los paladins"],[["sections",2,"steps",5,"map","marks",1,"label"],"23a41145a1ab190b","Detrás del Mead Hall"],[["sections",2,"steps",5,"map","marks",2,"label"],"301ca06684454c68","Oeste de Buddel"],[["sections",2,"steps",5,"map","marks",3,"label"],"774b327d34c6107f","Oeste del barco"],[["sections",2,"steps",5,"table","rows",0,1],"5bad885b7658ff6d","Guild de los paladins"],[["sections",2,"steps",5,"table","rows",1,1],"23a41145a1ab190b","Detrás del Mead Hall"],[["sections",2,"steps",5,"table","rows",2,1],"49d28c78571239bc","Al oeste de {npc:Buddel}"],[["sections",2,"steps",5,"table","rows",3,1],"594cffd0d09f2020","Al oeste del barco"],[["notes",0],"dfb6c7991fca795b","Los nidos de dragón de los Dragon Lairs y los Hidden Nests solo existen durante el evento."]]