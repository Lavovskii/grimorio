ope**:"],[["sections",2,"steps",2,"map","marks",0,"label"],"4aa21491ea920673","Klein eiland in het westen"],[["sections",2,"steps",2,"map","marks",1,"label"],"6acb37ec1d21b546","Uitkijkpunt noordwest"],[["sections",2,"steps",2,"map","marks",2,"label"],"f4f37b7ef7fe29c0","Middelste eiland"],[["sections",2,"steps",2,"map","marks",3,"label"],"003bc845f9e87d1b","Rivieroever"],[["sections",2,"steps",2,"map","marks",4,"label"],"7c7caccf3c3f6ecf","Zuidwestelijk eiland"],[["sections",2,"steps",2,"table","head",2],"e45951136f06bb35","Coördinaat"],[["sections",2,"steps",2,"table","rows",0,1],"4aa21491ea920673","Klein eiland in het westen"],[["sections",2,"steps",2,"table","rows",1,1],"0e80f9a17f3c9443","Uitkijkpunt noordwest (3 verdiepingen hoger)"],[["sections",2,"steps",2,"table","rows",2,1],"f4f37b7ef7fe29c0","Middelste eiland"],[["sections",2,"steps",2,"table","rows",3,1],"003bc845f9e87d1b","Rivieroever"],[["sections",2,"steps",2,"table","rows",4,1],"7c7caccf3c3f6ecf","Zuidwestelijk eiland"],[["sections",2,"steps",3,"text"],"3103114f144824ed","De 5 nesten van **Liberty Bay**:"],[["sections",2,"steps",3,"map","marks",0,"label"],"82351ee4a120e736","Magazijn"],[["sections",2,"steps",3,"map","marks",1,"label"],"11d5bf8d0d28d7d9","Vuurtoren"],[["sections",2,"steps",3,"map","marks",2,"label"],"030598d77111b0b7","Bij de berg van het fort"],[["sections",2,"steps",3,"map","marks",3,"label"],"d6a1284f8927ecd3","Zuidkust"],[["sections",2,"steps",3,"map","marks",4,"label"],"7d8f5d667b0f77fc","Achter het kasteel van Eleonore"],[["sections",2,"steps",3,"table","head",2],"e45951136f06bb35","Coördinaat"],[["sections",2,"steps",3,"table","rows",0,1],"662316b4c9b7d2c0","Magazijn (storage shed)"],[["sections",2,"steps",3,"table","rows",1,1],"11d5bf8d0d28d7d9","Vuurtoren"],[["sections",2,"steps",3,"table","rows",2,1],"030598d77111b0b7","Bij de berg van het fort"],[["sections",2,"steps",3,"table","rows",3,1],"d6a1284f8927ecd3","Zuidkust"],[["sections",2,"steps",3,"table","rows",4,1],"7d8f5d667b0f77fc","Achter het kasteel van Eleonore"],[["sections",2,"steps",4,"text"],"ea2c6dec436e2302","De 5 nesten van **Yalahar**: Je komt er per boot: {npc:Captain Max}, in Liberty Bay, brengt je erheen als je de rank Novice van de {wiki:Tibian Explorer Society|Explorer Society} hebt. Om terug te gaan brengt {npc:Captain Cookie}, in de haven van Yalahar, je naar Liberty Bay ({key:liberty bay}) of naar Thais ({key:thais})."],[["sections",2,"steps",4,"map","marks",0,"label"],"a2541bab0a805d51","Speelzaal"],[["sections",2,"steps",4,"map","marks",1,"label"],"9034acf1f0165061","Westelijke fontein"],[["sections",2,"steps",4,"map","marks",2,"label"],"82afa51e02fedf34","Helling van het Arena Quarter"],[["sections",2,"steps",4,"map","marks",3,"label"],"f561141d0d0c128f","Dokken"],[["sections",2,"steps",4,"map","marks",4,"label"],"ec8f196b5b099dbb","Gebouw van de Explorer Society"],[["sections",2,"steps",4,"table","head",2],"e45951136f06bb35","Coördinaat"],[["sections",2,"steps",4,"table","rows",0,1],"7cf9eef7e0171a2d","Speelzaal (1 verdieping lager)"],[["sections",2,"steps",4,"table","rows",1,1],"9034acf1f0165061","Westelijke fontein"],[["sections",2,"steps",4,"table","rows",2,1],"82afa51e02fedf34","Helling van het Arena Quarter"],[["sections",2,"steps",4,"table","rows",3,1],"f561141d0d0c128f","Dokken"],[["sections",2,"steps",4,"table","rows",4,1],"ec8f196b5b099dbb","Gebouw van de Explorer Society"],[["sections",2,"steps",5,"text"],"15966c48455a97ac","De 5 nesten van **Svargrond**: Neem de boot naar Svargrond in Carlin, Thais of Venore ({key:hi}, {key:svargrond}, {key:yes}); je komt aan bij de boot van {npc:Captain Breezelda}, die je ook terugbrengt."],[["sections",2,"steps",5,"map","marks",0,"label"],"5bad885b7658ff6d","Guild van de paladins"],[["sections",2,"steps",5,"map","marks",1,"label"],"23a41145a1ab190b","Achter de Mead Hall"],[["sections",2,"steps",5,"map","marks",2,"label"],"301ca06684454c68","Ten westen van Buddel"],[["sections",2,"steps",5,"map","marks",3,"label"],"