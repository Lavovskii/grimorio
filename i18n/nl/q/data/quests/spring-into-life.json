[[["duration"],"99abc2d4cfeaa32c","Event van 1 week (rond 16 tot 23 april); het zoeken naar nesten duurt 1–3 uur"],[["summary"],"790fffecaf26c314","Het lenteevent van Tibia (het vroegere paasevent). Een week lang verschijnen er drakennesten in de Dragon Lairs waaruit {creature:Dragon Hatchling|Dragon Hatchlings} komen (die 25% meer ervaring geven), laten konijnen {item:Coloured Egg|Coloured Eggs} vallen en liggen er {item:Hidden Nest|Hidden Nests} verstopt in de steden. Vind ze om {item:Surprise Nest|Surprise Nests} met snoep, chocolade, eieren en {item:Surprise Bag (Blue)|Blue Surprise Bags} te krijgen."],[["legend_pt"],"ae0d90d970952dbf","Verschillende avonturiers hebben ongebruikelijke activiteit gemeld in bijna alle bekende drakenholen. In hun grotten zijn veel drakeneieren gezien en het is slechts een kwestie van tijd voordat de volgende generatie van deze vervelende wezens uitkomt..."],[["start","label"],"5cb6da2e149321a2","Voorbeeld: nest in het park van Thais"],[["requirements",0],"b56d075592b306b1","Geen minimumlevel (aanbevolen 8)."],[["requirements",1],"da43154306549f9d","Een deel van het evenement is toegankelijk voor Free Accounts; sommige steden met nesten zijn alleen voor Premium."],[["requirements",2],"383bbed89726f2e4","Alleen actief tijdens het lente-evenement (ongeveer 16 tot 23 april)."],[["items_needed",0,"note"],"683de66cc43ca3de","of een vergelijkbaar gereedschap, om {item:Jungle Grass} weg te hakken bij 3 van de 5 nesten van Ab'Dendriel"],[["rewards",0,"text"],"eaee7f964b1c0c94","{creature:Dragon Hatchling|Dragon Hatchlings} geven tijdens het evenement **25% meer experience**"],[["rewards",5,"text"],"6f5ebc1c18fe6026","Mogelijk andere items uit de {item:Surprise Nest|Surprise Nests}"],[["tips",0],"ea3a4e92f8f6f0c8","Elke stad heeft 5 verborgen nesten. Gebruik de onderstaande tabellen en klik op de coördinaten om de kaart te openen: veel nesten zitten in torens of op hogere verdiepingen (z lager dan 7)."],[["tips",1],"df2b93263b1f7306","De drakennesten in de Dragon Lairs verschijnen pas weer na de volgende {wiki:Server Save}."],[["sections",0,"title"],"3094c8760c438018","1. Wat er tijdens het evenement verandert"],[["sections",0,"steps",0,"text"],"8cb356342758c6ac","Spring into Life heeft het oude paasevenement vervangen en bevat alles wat dat evenement had: tijdens het evenement laten {creature:Rabbit|Rabbits} {item:Coloured Egg|Coloured Eggs} vallen, die je ook bij sommige {wiki:Food Shopkeeper NPCs|etenverkopers} kunt kopen."],[["sections",0,"steps",1,"title"],"e068f3710d6140ed","Drakennesten"],[["sections",0,"steps",1,"text"],"1a239469c356f263","In veel {wiki:Dragon Lairs} door heel Tibia verschijnen drakennesten waaruit na verloop van tijd {creature:Dragon Hatchling|Dragon Hatchlings} komen. Tijdens het evenement geven de Dragon Hatchlings **25% meer experience**. De nesten verschijnen pas weer na de volgende Server Save."],[["sections",0,"steps",1,"warning"],"31a0a071cfcc53f9","In de Dragon Lairs vind je verschillende soorten {wiki:Dragons|draken}: ga er niet in als je er het level niet voor hebt."],[["sections",0,"steps",2,"title"],"84f9d5b971cd3243","Op nestenjacht"],[["sections",0,"steps",2,"text"],"aaa492a905dfcd31","Er liggen {item:Hidden Nest|Hidden Nests} verspreid door de steden van Tibia. Zoek ze en gebruik ze om {item:Surprise Nest|Surprise Nests} te krijgen, die je daarna gebruikt voor uiteenlopende beloningen (snoep, {item:Bar of Chocolate|chocolade}, eieren, {item:Surprise Bag (Blue)|Blue Surprise Bags} en mogelijk meer). In de volgende secties staan de 5 locaties per stad."],[["sections",0,"steps",3,"title"],"bd428401593565ed","Tussen steden reizen"],[["sections",0,"steps",3,"text"],"c5a7f7cccb056b5e","Om van de ene stad naar de andere te gaan, gebruik je de boten: praat in de haven met de kapitein en zeg {key:hi}, de naam van de stad (bijvoorbeeld {key:carlin}) en {key:yes}. Om terug te gaan neem je de boot terug in de haven van de stad waar je bent. Sommige steden zijn alleen met een Premium-account bereikbaar. De stappen van Cormaya, Fibula, Yalahar en Svargrond leggen uit hoe je daar komt."],[["sections",1,"title"],"344c4d36b371de12","2. Verborgen nesten: steden op het hoofdcontinent"],[["sections",1,"steps",0,"text"],"08c5a0f7756c6d4f","De 5 nesten van **Thais**:"],[["sections",1,"steps",0,"map","marks",0,"label"],"ac759f01236276e3","Toren van de noordpoort"],[["sections",1,"steps",0,"map","marks",1,"label"],"c927a3bdc9977353","Park"],[["sections",1,"steps",0,"map","marks",3,"label"],"8ef5a1080ba0432e","Zuidoostelijke toren"],[["sections",1,"steps",0,"map","marks",4,"label"],"b816c14dab12eae3","Guild van de sorcerers (aan de buitenkant)"],[["sections",1,"steps",0,"table","head",2],"e45951136f06bb35","Coördinaat"],[["sections",1,"steps",0,"table","rows",0,1],"71150388b2844b20","Toren van de noordpoort (3 verdiepingen hoger)"],[["sections",1,"steps",0,"table","rows",1,1],"c927a3bdc9977353","Park"],[["sections",1,"steps",0,"table","rows",3,1],"b21d11d8c543e64a","Zuidoostelijke toren (2 verdiepingen hoger)"],[["sections",1,"steps",0,"table","rows",4,1],"b816c14dab12eae3","Guild van de sorcerers (aan de buitenkant)"],[["sections",1,"steps",1,"text"],"b57500cd13f7998f","De 5 nesten van **Carlin**:"],[["sections",1,"steps",1,"map","marks",0,"label"],"5f58f7f7a3854343","Schaakbord"],[["sections",1,"steps",1,"map","marks",1,"label"],"07cdbedabec9184c","Guild van de druids"],[["sections",1,"steps",1,"map","marks",2,"label"],"70d61a878f77720f","Kasteeltoren"],[["sections",1,"steps",1,"table","head",2],"e45951136f06bb35","Coördinaat"],[["sections",1,"steps",1,"table","rows",0,1],"f0760d03330c9805","Schaakbord van Carlin"],[["sections",1,"steps",1,"table","rows",1,1],"684ea715d30dc3cf","Guild van de druids (1 verdieping hoger)"],[["sections",1,"steps",1,"table","rows",2,1],"54d59416d1467fe2","Kasteeltoren (top)"],[["sections",1,"steps",2,"text"],"161b10ccdb6f691c","De 5 nesten van **Ab'Dendriel**. Je hebt een {item:Machete} (of een vergelijkbaar gereedschap) nodig om {item:Jungle Grass} weg te hakken op de weg naar 3 ervan."],[["sections",1,"steps",2,"map","marks",0,"label"],"5922dc1ad331b496","Tempel"],[["sections",1,"steps",2,"map","marks",1,"label"],"f91ec574bb9846bc","Tuin"],[["sections",1,"steps",2,"map","marks",2,"label"],"3b17cdd329284677","Moeras"],[["sections",1,"steps",2,"map","marks",3,"label"],"4cda3eba808096ca","Portaal van het burgerschap"],[["sections",1,"steps",2,"map","marks",4,"label"],"93d2936881364ad6","Fruitwinkel"],[["sections",1,"steps",2,"table","head",2],"e45951136f06bb35","Coördinaat"],[["sections",1,"steps",2,"table","rows",0,1],"5922dc1ad331b496","Tempel"],[["sections",1,"steps",2,"table","rows",1,1],"f91ec574bb9846bc","Tuin"],[["sections",1,"steps",2,"table","rows",2,1],"3b17cdd329284677","Moeras"],[["sections",1,"steps",2,"table","rows",3,1],"4cda3eba808096ca","Portaal van het burgerschap"],[["sections",1,"steps",2,"table","rows",4,1],"93d2936881364ad6","Fruitwinkel"],[["sections",1,"steps",3,"text"],"85d0315bf0ac10cd","De 5 nesten van **Kazordoon**:"],[["sections",1,"steps",3,"map","marks",0,"label"],"f4ed4b799e323dd9","Mijnwagens bij de hoofdpoort"],[["sections",1,"steps",3,"map","marks",1,"label"],"8649d78d5e542935","Koninklijke keuken"],[["sections",1,"steps",3,"map","marks",2,"label"],"1d41e17588e41ce9","Bibliotheek van de Halls of Sorcery"],[["sections",1,"steps",3,"map","marks",3,"label"],"67a016e47782c10a","Boerderijen"],[["sections",1,"steps",3,"map","marks",4,"label"],"8cc03b06e162b2f8","De smederij"],[["sections",1,"steps",3,"table","head",2],"e45951136f06bb35","Coördinaat"],[["sections",1,"steps",3,"table","rows",0,1],"f4ed4b799e323dd9","Mijnwagens bij de hoofdpoort"],[["sections",1,"steps",3,"table","rows",1,1],"8649d78d5e542935","Koninklijke keuken"],[["sections",1,"steps",3,"table","rows",2,1],"1d41e17588e41ce9","Bibliotheek van de Halls of Sorcery"],[["sections",1,"steps",3,"table","rows",3,1],"67a016e47782c10a","Boerderijen"],[["sections",1,"steps",3,"table","rows",4,